        <mxCell id="p3-logicalc-1" value="M3 — ordering events across nodes: hybrid logical clocks" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="p3-1">
          <mxGeometry x="20" y="10" width="1600" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p3-logicalc-2" value="Wall clocks drift, Lamport clocks lose real time. HLC keeps both: (l, c) where l tracks the largest physical time seen and c breaks ties. Audit logs from different nodes then merge in an order consistent with causality." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="p3-1">
          <mxGeometry x="20" y="44" width="1600" height="34" as="geometry" />
        </mxCell>
