        <mxCell id="p2-chordpla-6" value="2" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="p2-1" source="p2-N42" target="p2-N51">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-chordpla-7" value="3" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="p2-1" source="p2-N51" target="p2-N56">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-chordpla-8" value="&lt;span style=&quot;font-size:12px&quot;&gt;lookup(K54) from N8:&lt;br&gt;N8 → N42 → N51 → N56&lt;br&gt;O(log N) hops&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;align=center;" vertex="1" parent="p2-1">
          <mxGeometry x="470" y="540" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-chordpla-9" value="&lt;b&gt;Finger table of N8 (m = 6)&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;i&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;start = 8 + 2^(i−1)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;successor&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;9&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;N14&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;10&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;N14&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;12&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;N14&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;16&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;N21&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;24&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;N32&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;40&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;N42&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=11;overflow=fill;fontColor=#222222;" vertex="1" parent="p2-1">
          <mxGeometry x="900" y="110" width="380" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p2-chordpla-10" value="&lt;b&gt;How ZTC uses it&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;key = SHA-1(device SPIFFE ID); owner = successor(key)&lt;/li&gt;&lt;li&gt;GET /v1/owner?device=… on any fog node&lt;/li&gt;&lt;li&gt;the owner keeps the device's windows and IDS state, so detectors are not split across nodes&lt;/li&gt;&lt;li&gt;membership changes come from SWIM; only neighbouring keys move&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="1320" y="110" width="380" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p2-chordpla-11" value="&lt;b&gt;Checked against theory and my own IN5020 A3&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;unit test: finger table for m = 3, nodes {0, 1, 3} (textbook example)&lt;/li&gt;&lt;li&gt;≈ ½·log₂N hops on average at N = 100 (≈ 4.1), matching the Java implementation from A3&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="900" y="370" width="800" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-chordpla-12" value="&lt;b&gt;Design choice: why a DHT at all?&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;a central placement table in the cloud would not survive a WAN partition&lt;/li&gt;&lt;li&gt;consistent hashing gives balanced placement without coordination&lt;/li&gt;&lt;li&gt;alternative: rendezvous hashing — simpler, but O(N) per lookup; Chord shows the routing idea&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="900" y="490" width="800" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-chordpla-13" value="&lt;b&gt;Security note&lt;/b&gt;: ring position is derived from a hash, so a node cannot pick where it lands without grinding IDs; fog identities come from the CA, and state handover between owners uses the same sealed-state mechanism as migration (RQ3)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;fontColor=#222222;spacing=4;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="900" y="630" width="800" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Logical clocks" id="page-3">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="700" math="0" shadow="0" background="#FFFFFF">
      <root>
