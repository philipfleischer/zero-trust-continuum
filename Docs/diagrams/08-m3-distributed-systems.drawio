        <mxCell id="p0-raftpdpc-2" value="Policy installs, revocations and compromises go through the Raft log, so every replica applies the same changes in the same order. Decisions are served locally from each replica's state." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="p0-1">
