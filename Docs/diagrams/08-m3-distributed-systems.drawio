        <mxCell id="p0-raftpdpc-1" value="M3 — a replicated control plane: three PDPs with Raft" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="p0-1">
