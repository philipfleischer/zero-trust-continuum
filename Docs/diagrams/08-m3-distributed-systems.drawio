        <mxCell id="p0-raftpdpc-19" value="&lt;span style=&quot;font-size:11px&quot;&gt;commitIndex 3 · applied 3&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;fontColor=#1f3a5f;" vertex="1" parent="p0-F2">
