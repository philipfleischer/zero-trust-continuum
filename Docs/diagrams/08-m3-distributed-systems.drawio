        <mxCell id="p2-chordpla-4" value="owner" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#6c8ebf;fontColor=#1f3a5f;dashed=1;" edge="1" parent="p2-1" source="p2-K54" target="p2-N56">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-chordpla-5" value="1" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="p2-1" source="p2-N8" target="p2-N42">
