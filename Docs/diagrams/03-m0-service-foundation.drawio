        <mxCell id="p0-services-18" value="&lt;b&gt;Conventions enforced by CI&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;gofmt, go vet, golangci-lint (gosec, staticcheck, errcheck, revive)&lt;/li&gt;&lt;li&gt;go test -race with coverage&lt;/li&gt;&lt;li&gt;every exported function documented&lt;/li&gt;&lt;li&gt;Conventional Commits, merge commits&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p0-1">
