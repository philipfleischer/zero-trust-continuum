        <mxCell id="p0-main" value="&lt;b&gt;main()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;svc.Run(name, register)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-proc">
