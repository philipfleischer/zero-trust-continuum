          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-met" value="&lt;b&gt;metrics registry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Counter, Gauge, Histogram with labels, Prometheus text exposition&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-proc">
