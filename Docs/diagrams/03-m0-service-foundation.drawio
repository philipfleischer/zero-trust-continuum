        <mxCell id="p0-services-5" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-log" target="p0-met">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-mux" value="&lt;b&gt;health mux&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;/healthz liveness · /readyz readiness checks · /metrics&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-proc">
