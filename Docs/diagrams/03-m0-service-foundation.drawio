        <mxCell id="p0-services-6" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-met" target="p0-mux">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-api" value="&lt;b&gt;service routes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;registered by the service, e.g. POST /v1/decide&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-proc">
