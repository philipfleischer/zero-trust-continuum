          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-ins" value="&lt;b&gt;instrumentation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;RED metrics per route: ztc_http_requests_total, ztc_http_request_duration_seconds&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-proc">
          <mxGeometry x="30" y="613.6" width="520" height="75.4" as="geometry" />
        </mxCell>
        <mxCell id="p0-services-8" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-api" target="p0-ins">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-srv" value="&lt;b&gt;httpx server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;ReadHeader / Read / Write / Idle timeouts, body size limit, strict JSON (unknown fields rejected)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-proc">
          <mxGeometry x="30" y="707.2" width="520" height="75.4" as="geometry" />
        </mxCell>
        <mxCell id="p0-services-9" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-ins" target="p0-srv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-sig" value="&lt;b&gt;graceful shutdown&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;SIGINT / SIGTERM ⇒ stop accepting, drain in-flight requests, exit 0&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-proc">
          <mxGeometry x="30" y="800.8" width="520" height="75.4" as="geometry" />
        </mxCell>
        <mxCell id="p0-services-10" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-srv" target="p0-sig">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-services-11" value="&lt;b&gt;Request path&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;client → httpx server (timeouts, size limit)&lt;/li&gt;&lt;li&gt;→ instrumentation (count, time)&lt;/li&gt;&lt;li&gt;→ service handler&lt;/li&gt;&lt;li&gt;→ JSON response with explicit errors&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p0-1">
          <mxGeometry x="990" y="130.0" width="470" height="156.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-services-12" value="&lt;b&gt;Why health and metrics are separate from the API&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;liveness ≠ readiness: a PDP without a policy is alive but not ready&lt;/li&gt;&lt;li&gt;probes and scrapes stay unauthenticated, so they expose nothing sensitive&lt;/li&gt;&lt;li&gt;from M5 the API needs mTLS, /healthz and /metrics stay plain for probes&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p0-1">
          <mxGeometry x="990" y="312.0" width="470" height="169.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-services-13" value="&lt;b&gt;Standard library only&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;net/http, log/slog, crypto/*, encoding/json&lt;/li&gt;&lt;li&gt;no supply-chain dependencies in the trust path&lt;/li&gt;&lt;li&gt;Prometheus format written by hand (~200 lines)&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p0-1">
          <mxGeometry x="990" y="507.0" width="470" height="143.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-prom" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;scrapes /metrics&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="700" y="533.0" width="220" height="91.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-kube" value="&lt;b&gt;Kubernetes kubelet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;livenessProbe → /healthz&lt;br&gt;readinessProbe → /readyz&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="700" y="650.0" width="220" height="104.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-logs" value="&lt;b&gt;Log pipeline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;JSON lines → SIEM&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="700" y="361.4" width="220" height="91.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-ci" value="&lt;b&gt;Operator / CI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;make build test lint&lt;br&gt;curl :8181/healthz&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
