        <mxCell id="p0-services-1" value="M0 — one service shell for every ZTC service" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="13.0" width="1400" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="p0-services-2" value="Nine services, one start-up path (internal/svc). Operability is designed in from the first commit: configuration, logging, metrics, health and shutdown behave the same everywhere." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=17;fontColor=#555555;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="57.2" width="1400" height="44.2" as="geometry" />
        </mxCell>
        <mxCell id="p0-proc" value="cmd/ztc-&amp;lt;service&amp;gt; process" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=18;fontColor=#2d4d1f;" vertex="1" parent="p0-1">
