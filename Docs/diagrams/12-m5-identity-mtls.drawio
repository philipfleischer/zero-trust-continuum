        <mxCell id="p1-mtlsrequ-1" value="M5 — a request over mutual TLS" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="13.0" width="1500" height="41.6" as="geometry" />
