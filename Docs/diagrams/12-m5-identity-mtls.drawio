<mxfile host="app.diagrams.net" agent="ztc-diagram-generator" type="device">
  <diagram name="SPIFFE identity and PKI" id="page-0">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="975" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p0-0" />
        <mxCell id="p0-1" parent="p0-0" />
        <mxCell id="p0-spiffeid-1" value="M5 — workload identity: SPIFFE IDs in short-lived certificates" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="13.0" width="1600" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-2" value="Every service and every device gets its own cryptographic identity, so a request is trusted because of who sent it, never because of where it came from (NIST tenet 2). Short lifetimes make revocation mostly a matter of not renewing." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=17;fontColor=#555555;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="57.2" width="1600" height="44.2" as="geometry" />
        </mxCell>
        <mxCell id="p0-root" value="&lt;b&gt;Root key&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;offline in production (HSM + key ceremony); in memory in ZTC (documented simplification)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="40" y="143.0" width="300" height="104.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-ca" value="&lt;b&gt;ztc-ca (issuing)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;ECDSA P-256 X.509-SVIDs · Ed25519 token key (separate key, separate purpose)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="40" y="312.0" width="300" height="117.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-3" value="signs" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-root" target="p0-ca">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-leaf0" value="&lt;span style=&quot;font-size:15px&quot;&gt;spiffe://grid.example/edge/pmu/pmu-b1-1&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;fontFamily=Courier New;" vertex="1" parent="p0-1">
          <mxGeometry x="420" y="156.0" width="360" height="71.5" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-4" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-ca" target="p0-leaf0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-leaf1" value="&lt;span style=&quot;font-size:15px&quot;&gt;spiffe://grid.example/fog/pep/sub1&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;fontFamily=Courier New;" vertex="1" parent="p0-1">
          <mxGeometry x="420" y="253.5" width="360" height="71.5" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-5" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-ca" target="p0-leaf1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-leaf2" value="&lt;span style=&quot;font-size:15px&quot;&gt;spiffe://grid.example/cloud/pdp/pdp-0&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;fontFamily=Courier New;" vertex="1" parent="p0-1">
          <mxGeometry x="420" y="351.0" width="360" height="71.5" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-6" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-ca" target="p0-leaf2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-leaf3" value="&lt;span style=&quot;font-size:15px&quot;&gt;spiffe://grid.example/cloud/admin/alice&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;fontFamily=Courier New;" vertex="1" parent="p0-1">
          <mxGeometry x="420" y="448.5" width="360" height="71.5" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-7" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-ca" target="p0-leaf3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-8" value="&lt;b&gt;ID scheme&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:15px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Part&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Meaning&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Used by&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;grid.example&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;trust domain (one per operator)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;VerifyConnection rejects other domains&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;/edge, /fog, /cloud&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;layer&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;subject.layer in policy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;/pmu, /pep, /admin …&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;kind / role&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;inventory → roles&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;/pmu-b1-1&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;instance&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;audit, trust per subject&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=15;overflow=fill;fontColor=#222222;" vertex="1" parent="p0-1">
          <mxGeometry x="840" y="143.0" width="860" height="221.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-9" value="&lt;b&gt;Endpoints of ztc-ca&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:15px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Endpoint&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Purpose&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;POST /v1/issue&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;CSR + join token → X.509-SVID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;POST /v1/token&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;join token → Ed25519-signed token (M1)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;GET /v1/bundle&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;trust bundle (CA certificates)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;GET /v1/keys&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;token verification keys (kid)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;POST /v1/revoke · GET /v1/revoked&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;serials revoked before expiry&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=15;overflow=fill;fontColor=#222222;" vertex="1" parent="p0-1">
          <mxGeometry x="840" y="390.0" width="860" height="247.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-e1" value="&lt;b&gt;① generate key pair on the device&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;private key never leaves it&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="40" y="650.0" width="260" height="104.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-e2" value="&lt;b&gt;② CSR + one-time join token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;join token issued out of band for this device&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="320" y="650.0" width="260" height="104.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-10" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-e1" target="p0-e2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-e3" value="&lt;b&gt;③ CA checks token, maps it to the SPIFFE ID in the inventory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;the device cannot choose its own name&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="600" y="650.0" width="260" height="104.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-11" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-e2" target="p0-e3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-e4" value="&lt;b&gt;④ SVID with TTL (e.g. 1 h)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;URI SAN = SPIFFE ID; no IP or DNS names needed&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="880" y="650.0" width="260" height="104.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-12" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-e3" target="p0-e4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-e5" value="&lt;b&gt;⑤ renew at 2/3 of lifetime&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;a missed renewal expires the identity by itself&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="1160" y="650.0" width="260" height="104.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-13" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-e4" target="p0-e5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-e6" value="&lt;b&gt;⑥ revocation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;stop renewing; for urgent cases add to /v1/revoked and bump the PDP epoch&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="1440" y="650.0" width="260" height="104.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-14" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-e5" target="p0-e6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-15" value="&lt;b&gt;Enrolment and life cycle&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;" vertex="1" parent="p0-1">
          <mxGeometry x="40" y="611.0" width="400" height="31.2" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-16" value="&lt;b&gt;Why SPIFFE-style and short-lived (ADR 0005)&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;names describe workloads, not hosts: survives IP changes, migration and NAT&lt;/li&gt;&lt;li&gt;short TTLs replace most of CRL / OCSP, which fog nodes may not be able to reach during a partition&lt;/li&gt;&lt;li&gt;same identity for mTLS and for policy (subjects: spiffe://*/cloud/admin/*)&lt;/li&gt;&lt;li&gt;production equivalent: SPIRE with node and workload attestation; written by hand here to keep the trust path readable&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p0-1">
          <mxGeometry x="40" y="793.0" width="1000" height="136.5" as="geometry" />
        </mxCell>
        <mxCell id="p0-spiffeid-17" value="&lt;b&gt;Implementation pitfalls&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;use tls.Config.VerifyConnection, not VerifyPeerCertificate (gosec G123: resumed sessions skip the latter)&lt;/li&gt;&lt;li&gt;chrony on every node: short-lived certificates need synchronised clocks&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="1080" y="793.0" width="620" height="136.5" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="mTLS request sequence" id="page-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1274" math="0" shadow="0" background="#FFFFFF">
      <root>
