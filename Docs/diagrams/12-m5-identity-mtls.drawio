        </mxCell>
        <mxCell id="p1-mtlsrequ-19" value="forward over mTLS (PEP's own SVID)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;verticalAlign=bottom;" edge="1" parent="p1-1">
