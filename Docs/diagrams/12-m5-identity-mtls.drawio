        <mxCell id="p1-mtlsrequ-22" value="later" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=3;container=1;collapsible=0;recursiveResize=0;fillColor=#ffffff;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=16;fontColor=#333333;dashed=0;strokeColor=#666666;fillColor=none;fontSize=15;" vertex="1" parent="p1-1">
          <mxGeometry x="60" y="936.0" width="1300" height="208.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-mtlsrequ-23" value="renew at 2/3 of TTL (40 min)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;verticalAlign=bottom;" edge="1" parent="p1-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="988.0" as="sourcePoint" />
            <mxPoint x="420" y="988.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-mtlsrequ-24" value="revocation epoch ↑ (device compromised)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;verticalAlign=bottom;" edge="1" parent="p1-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="1053.0" as="sourcePoint" />
            <mxPoint x="720" y="1053.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-mtlsrequ-25" value="tear down the device's TLS sessions, flush cache" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;align=left;spacingLeft=46;labelBackgroundColor=#ffffff;" edge="1" parent="p1-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="1066.0" as="sourcePoint" />
            <mxPoint x="720" y="1099.8" as="targetPoint" />
            <Array as="points">
              <mxPoint x="760" y="1066.0" />
              <mxPoint x="760" y="1099.8" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-mtlsrequ-26" value="&lt;b&gt;Why sessions must be torn down&lt;/b&gt;: with long-lived sessions the PEP authenticates once per handshake. A revoked device would keep its open connection, and every request becomes a cache miss and a WAN round trip — turning a revoked device into load on the PDP. Revocation therefore closes sessions, and session lifetime is capped by the certificate TTL." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="60" y="1170.0" width="1300" height="91.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>