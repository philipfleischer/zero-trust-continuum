          <mxGeometry x="210" y="496" width="540" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1-defencei-8" value="&lt;b&gt;An Industroyer-style attack path, layer by layer&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:17px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;width:45%;&quot;&gt;Attacker step (ATT&amp;amp;CK for ICS)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;width:55%;&quot;&gt;Stopped or detected by&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;initial access through the IT / enterprise network&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;no conduit from L5 into L3; DMZ + zone-based firewall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;lateral movement onto the station bus&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;802.1X, NetworkPolicy / ACL; PEP still requires an identity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;send a breaker command (T0855 Unauthorized Command Message)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;operate-breaker: operator role + trust ≥ 0.8 + control zone; obligation reverify 10 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;spoof or replay GOOSE&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;stNum / sqNum validator, optional IEC 62351-6 MAC, IDS rule ICS-004&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;manipulate the operator's view (T0832)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;IDS EWMA / redundancy CUSUM → behaviour signal → lock-out&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;repeated denied attempts&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;each denial lowers trust → everything denied (invalidate-on-deny)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;cover tracks&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;hash-chained audit log exported to a SIEM&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=17;overflow=fill;fontColor=#222222;" vertex="1" parent="p1-1">
          <mxGeometry x="970" y="80" width="730" height="450" as="geometry" />
        </mxCell>
        <mxCell id="p1-defencei-9" value="&lt;b&gt;Design principle&lt;/b&gt;: no single control is load-bearing. The ACL can be misconfigured, a credential can be stolen, the IDS can miss a slow ramp; each failure is caught by another layer, and the residual risk is written down in the STRIDE table." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=17;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="970" y="560" width="730" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>