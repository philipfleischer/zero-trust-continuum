        <mxCell id="p1-part" value="&lt;b&gt;PartitionController&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;cuts the WanLink of one substation for a configured interval&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;fontColor=#222222;spacing=4;" vertex="1" parent="p1-1">
