        <mxCell id="p0-onemodel-1" value="M6 — one model, two worlds: Go implementation and OMNeT++ simulation" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="10" width="1600" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p0-onemodel-2" value="The running system shows the design works; the simulation measures it at scale with controlled WAN delay, partitions and attacks. Both share the same semantics, enforced by shared test vectors." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="44" width="1600" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p0-sem" value="&lt;b&gt;Shared semantics&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;trust formula and levels&lt;/li&gt;&lt;li&gt;policy: deny-overrides, default deny&lt;/li&gt;&lt;li&gt;decision cache + invalidate-on-deny&lt;/li&gt;&lt;li&gt;credential cost per device class&lt;/li&gt;&lt;li&gt;migration protocol&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;fontColor=#222222;spacing=4;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p0-1">
          <mxGeometry x="640" y="110" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p0-go" value="&lt;b&gt;Go reference implementation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;services/internal: trust, policy, pdp, token, migration …&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="120" y="330" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p0-cpp" value="&lt;b&gt;C++17 core (sim/core)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;trust_model, policy_engine, decision_cache, crypto_cost, migration_model · no OMNeT++ dependency&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
