<mxfile host="app.diagrams.net" agent="ztc-diagram-generator" type="device">
  <diagram name="DevSecOps pipeline" id="page-0">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p0-0" />
        <mxCell id="p0-1" parent="p0-0" />
        <mxCell id="p0-devsecop-1" value="DevSecOps: from commit to signed image" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="10" width="1600" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p0-devsecop-2" value="Every change goes through a short-lived branch and a pull request; main is always green (build, tests, end-to-end demo). Security checks run on every PR and weekly, results land in GitHub code scanning." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="44" width="1600" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p0-dev" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;branch feat/… · Conventional Commits&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="140" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p0-pr" value="&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;template: what, why, how tested · review&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="240" y="140" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p0-devsecop-3" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-dev" target="p0-pr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-checks" value="Checks (parallel jobs, all must pass)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=3;container=1;collapsible=0;recursiveResize=0;fillColor=#ffffff;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#333333;" vertex="1" parent="p0-1">
          <mxGeometry x="480" y="100" width="1220" height="470" as="geometry" />
        </mxCell>
        <mxCell id="p0-ci" value="&lt;b&gt;CI (every PR)&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;gofmt, go vet&lt;/li&gt;&lt;li&gt;golangci-lint: gosec, staticcheck, errcheck, revive&lt;/li&gt;&lt;li&gt;go test -race + coverage&lt;/li&gt;&lt;li&gt;actionlint&lt;/li&gt;&lt;li&gt;e2e: scripts/demo.sh asserts lock-out&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p0-checks">
          <mxGeometry x="15" y="40" width="380" height="195" as="geometry" />
        </mxCell>
        <mxCell id="p0-sec" value="&lt;b&gt;Security (every PR + weekly)&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;CodeQL (Go, Python)&lt;/li&gt;&lt;li&gt;govulncheck, gosec&lt;/li&gt;&lt;li&gt;gitleaks (secrets)&lt;/li&gt;&lt;li&gt;Trivy: filesystem + image&lt;/li&gt;&lt;li&gt;SARIF → code scanning&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p0-checks">
          <mxGeometry x="415" y="40" width="380" height="195" as="geometry" />
        </mxCell>
        <mxCell id="p0-img" value="&lt;b&gt;Containers (main)&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;multi-stage, CGO off, -trimpath&lt;/li&gt;&lt;li&gt;distroless static, non-root&lt;/li&gt;&lt;li&gt;buildx amd64 + arm64&lt;/li&gt;&lt;li&gt;SBOM + provenance&lt;/li&gt;&lt;li&gt;hadolint · push to GHCR&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p0-checks">
          <mxGeometry x="815" y="40" width="380" height="195" as="geometry" />
        </mxCell>
        <mxCell id="p0-sim" value="&lt;b&gt;Simulation + analytics&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;CMake + ctest, ASan / UBSan&lt;/li&gt;&lt;li&gt;clang-format check&lt;/li&gt;&lt;li&gt;OMNeT++ smoke run in a container&lt;/li&gt;&lt;li&gt;Python tests on 3.12 and 3.14&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p0-checks">
          <mxGeometry x="15" y="255" width="380" height="195" as="geometry" />
        </mxCell>
        <mxCell id="p0-dep" value="&lt;b&gt;Deploy checks&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;kustomize render + kubeconform&lt;/li&gt;&lt;li&gt;helm lint / template&lt;/li&gt;&lt;li&gt;terraform fmt + validate&lt;/li&gt;&lt;li&gt;ansible-lint · generated-files drift check&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p0-checks">
          <mxGeometry x="415" y="255" width="380" height="195" as="geometry" />
        </mxCell>
        <mxCell id="p0-devsecop-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-pr" target="p0-checks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-merge" value="&lt;b&gt;merge commit to main&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;branch protection: all checks green&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="240" y="300" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p0-tag" value="&lt;b&gt;tag vX.Y.Z&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;one per milestone&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="240" y="420" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p0-devsecop-5" value="all green" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=0;exitY=0.55;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-checks" target="p0-merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-devsecop-6" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-merge" target="p0-tag">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-dbot" value="&lt;b&gt;Dependabot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GitHub Actions + Go modules&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="300" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p0-devsecop-7" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#6c8ebf;fontColor=#1f3a5f;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-dbot" target="p0-pr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-devsecop-8" value="&lt;b&gt;Supply-chain stance&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;Go standard library only: nothing third-party in the trust path (ADR)&lt;/li&gt;&lt;li&gt;pinned tool versions; lint locally with the same version as CI&lt;/li&gt;&lt;li&gt;images are distroless: no shell, no package manager, tiny CVE surface&lt;/li&gt;&lt;li&gt;SBOM published with every image for later vulnerability matching&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="640" width="820" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p0-devsecop-9" value="&lt;b&gt;Why fail the build on the demo?&lt;/b&gt; The end-to-end demo is the system's behavioural contract: if a change lets the compromised device keep access or breaks audit verification, CI is red even when every unit test passes." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p0-1">
          <mxGeometry x="880" y="640" width="820" height="100" as="geometry" />
        </mxCell>
      </root>
