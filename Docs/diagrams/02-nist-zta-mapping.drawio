        <mxCell id="p0-nistsp80-1" value="NIST SP 800-207 logical components mapped to ZTC" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p0-1">
