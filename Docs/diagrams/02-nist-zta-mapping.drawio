  <diagram name="NIST SP 800-207 mapping" id="page-0">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1378" math="0" shadow="0" background="#FFFFFF">
