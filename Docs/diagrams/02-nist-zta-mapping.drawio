        </mxCell>
        <mxCell id="p0-nistsp80-2" value="The core ZTA model (NIST SP 800-207, fig. 2): a control plane that decides and a data plane that enforces. Every box is labelled with the ZTC service or package that implements it." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=17;fontColor=#555555;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="57.2" width="1400" height="44.2" as="geometry" />
        </mxCell>
        <mxCell id="p0-cp" value="Control plane" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=17;dashed=1;fillColor=#fafafa;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="117.0" width="1460" height="429.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-dp" value="Data plane" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=17;dashed=1;fillColor=#fafafa;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="572.0" width="1460" height="299.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-pdp" value="Policy Decision Point — ztc-pdp" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=18;fontColor=#1f3a5f;" vertex="1" parent="p0-1">
          <mxGeometry x="450" y="156.0" width="600" height="273.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-pe" value="&lt;b&gt;Policy Engine (PE)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;decides: ABAC rules with deny-overrides and default deny (internal/policy) combined with the continuous trust score (internal/trust); MinTrust per rule&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-pdp">
          <mxGeometry x="20" y="52.0" width="560" height="91.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-pa" value="&lt;b&gt;Policy Administrator (PA)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;executes: decision API with TTL and obligations, revocation epochs, break-glass, tells the PEP to open or close the path; credentials via ztc-ca&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-pdp">
          <mxGeometry x="20" y="169.0" width="560" height="84.5" as="geometry" />
        </mxCell>
        <mxCell id="p0-nistsp80-3" value="decision" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-pe" target="p0-pa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-cdm" value="&lt;b&gt;CDM system&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;device posture + ICS IDS behaviour scores (ztc-ids, internal/ids)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
