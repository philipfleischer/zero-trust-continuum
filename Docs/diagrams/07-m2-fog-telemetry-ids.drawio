        <mxCell id="p0-telemetr-27" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7038461538461539;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-d3" target="p0-pep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-d4" value="&lt;b&gt;EV charger&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;power, setpoint&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontSize=18;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-telemetr-23">
          <mxGeometry x="1080" y="45" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p0-telemetr-28" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.9076923076923077;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-d4" target="p0-pep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-atk" value="&lt;b&gt;Attack injector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;ZTC_ATTACK = fdi · fdi-ramp · replay · flood, ZTC_ATTACK_AFTER&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=18;fontColor=#222222;spacing=4;" vertex="1" parent="p0-telemetr-23">
          <mxGeometry x="1340" y="45" width="320" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p0-telemetr-29" value="&lt;b&gt;Design choices&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:17px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Choice&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Why&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Alternative considered&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;IDS on the fog, on raw data&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;sees every sample; detection latency independent of the WAN&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;cloud-side detection on aggregates: cheaper, but blind to fast attacks&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;composable stages over channels&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;each stage unit-tested; easy to add GOOSE/Modbus taps later&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;one big handler&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;tumbling (not sliding) windows&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;bounded memory, one aggregate per series per second&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;sliding windows: smoother, more CPU&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;telemetry also goes through the PEP&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;a sensor is a subject like any other; per-device rate limits&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;trusted field network: exactly what zero trust rejects&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=17;overflow=fill;fontColor=#222222;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="1180" width="1680" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Lock-out loop (RQ4)" id="page-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1300" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p1-0" />
        <mxCell id="p1-1" parent="p1-0" />
        <mxCell id="p1-lockoutl-1" value="M2 — continuous verification: from anomaly to lock-out" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="13.0" width="1600" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-2" value="The loop that makes this zero trust rather than perimeter security: a device that was allowed a second ago is denied as soon as its behaviour changes, and only that device." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=17;fontColor=#555555;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="57.2" width="1600" height="44.2" as="geometry" />
        </mxCell>
        <mxCell id="p1-A" value="&lt;b&gt;Compromised PMU&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;pmu-b1-3 injects false data&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="40.0" y="546.0" width="240" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-B" value="&lt;b&gt;ztc-pep&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;authenticates; policy allows telemetry writes&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="239.99999999999983" y="208.3" width="240" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-C" value="&lt;b&gt;ztc-fog + IDS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;EWMA z = 19σ → alert ANOM-001 (ATT&amp;amp;CK for ICS T0832 Manipulation of View)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="640.0" y="208.3" width="240" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-D" value="&lt;b&gt;ztc-pdp&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;behaviour ≥ 0.9 ⇒ compromise: trust 0, revocation epoch + 1, audit, alert&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="840.0" y="546.0" width="240" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-E" value="&lt;b&gt;Decision caches&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;every PEP polls GET /v1/revocations, sees the new epoch and flushes&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=15;" vertex="1" parent="p1-1">
          <mxGeometry x="640.0" y="883.7" width="240" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-F" value="&lt;b&gt;ztc-pep&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;next request: cache miss → PDP deny → 403&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=16;fontStyle=1;" vertex="1" parent="p1-1">
          <mxGeometry x="240.00000000000006" y="883.7" width="240" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-3" value="① telemetry with +4 kV bias" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p1-1" source="p1-A" target="p1-B">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-4" value="② allowed&lt;br&gt;(policy permits&lt;br&gt;writes)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p1-1" source="p1-B" target="p1-C">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-5" value="③ POST /v1/signals behaviour = 1.0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="p1-1" source="p1-C" target="p1-D">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-6" value="④ epoch + 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="p1-1" source="p1-D" target="p1-E">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-7" value="⑤ flush" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="p1-1" source="p1-E" target="p1-F">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-8" value="⑥ request denied" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p1-1" source="p1-F" target="p1-A">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-9" value="&lt;b&gt;unauthorized access window&lt;/b&gt;&lt;br&gt;= detection delay&lt;br&gt;+ signal transport&lt;br&gt;+ cache staleness&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;(≤ min(TTL, poll interval))&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;fontSize=17;" vertex="1" parent="p1-1">
          <mxGeometry x="430" y="520.0" width="260" height="182.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-10" value="&lt;b&gt;Two independent paths to lock-out&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;&lt;b&gt;IDS path&lt;/b&gt;: behaviour signal ⇒ compromise ⇒ epoch ⇒ every cache flushed&lt;/li&gt;&lt;li&gt;&lt;b&gt;Denial path&lt;/b&gt;: lateral-movement and breaker attempts are denied; each denial lowers trust until even telemetry falls below the floor — often before the IDS fires&lt;/li&gt;&lt;li&gt;invalidate-on-deny makes the second path work through a cache&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="1110" y="156.0" width="590" height="175.5" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-11" value="&lt;b&gt;Only the compromised device is affected&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;trust is per subject; honest PMUs keep high trust and their cached allows&lt;/li&gt;&lt;li&gt;the epoch flush costs every PEP one round trip per subject, then the cache refills&lt;/li&gt;&lt;li&gt;operators can clear a compromise only through the audited admin API&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="1110" y="357.5" width="590" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-12" value="&lt;b&gt;Checked in CI&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;scripts/demo.sh starts CA, PDP, ingest, fog, PEP and edge devices with an FDI attack&lt;/li&gt;&lt;li&gt;the job fails unless the attacker ends with trust 0 and 403, honest devices keep high trust, and ztcctl audit verify passes&lt;/li&gt;&lt;li&gt;regression test: a cached allow is never served after a compromise&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="1110" y="513.5" width="590" height="149.5" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-13" value="&lt;b&gt;Timeline of one compromise&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="1079.0" width="400" height="28.6" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-14" value="&lt;span style=&quot;font-size:15px&quot;&gt;detection delay (IDS warm-up, threshold)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fillColor=#f8cecc;strokeColor=#888888;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="1118.0" width="520" height="52.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-15" value="&lt;span style=&quot;font-size:15px&quot;&gt;signal&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fillColor=#e1d5e7;strokeColor=#888888;" vertex="1" parent="p1-1">
          <mxGeometry x="560" y="1118.0" width="120" height="52.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-16" value="&lt;span style=&quot;font-size:15px&quot;&gt;cache staleness ≤ poll&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fillColor=#fff2cc;strokeColor=#888888;" vertex="1" parent="p1-1">
          <mxGeometry x="680" y="1118.0" width="260" height="52.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-17" value="&lt;span style=&quot;font-size:15px&quot;&gt;first 403&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fillColor=#d5e8d4;strokeColor=#888888;" vertex="1" parent="p1-1">
          <mxGeometry x="940" y="1118.0" width="140" height="52.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-18" value="&lt;span style=&quot;font-size:15px&quot;&gt;t₀&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;" vertex="1" parent="p1-1">
          <mxGeometry x="30" y="1176.5" width="40" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-19" value="&lt;span style=&quot;font-size:15px&quot;&gt;attacker allowed&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;fontColor=#b85450;" vertex="1" parent="p1-1">
          <mxGeometry x="300" y="1176.5" width="300" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-lockoutl-20" value="&lt;span style=&quot;font-size:15px&quot;&gt;attacker denied&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;fontColor=#2d4d1f;" vertex="1" parent="p1-1">
          <mxGeometry x="930" y="1176.5" width="200" height="26.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Audit log" id="page-2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="676" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p2-0" />
        <mxCell id="p2-1" parent="p2-0" />
        <mxCell id="p2-auditlog-1" value="M2 — tamper-evident audit log (hash chain)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="13.0" width="1600" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="p2-auditlog-2" value="Every decision, signal, compromise and policy change is appended to a JSONL log where each entry commits to the one before it. Editing or deleting any entry breaks every later link (IEC 62443 SR 2.8, NIST tenet 7)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=17;fontColor=#555555;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="57.2" width="1600" height="44.2" as="geometry" />
        </mxCell>
        <mxCell id="p2-e0" value="&lt;b&gt;genesis&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;seq 0 · HLC time&lt;br&gt;prev = 000…0&lt;br&gt;kind: start, node: pdp-0&lt;br&gt;hash = SHA-256(prev ‖ canonical JSON)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;spacingLeft=10;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="143.0" width="360" height="169.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" value="&lt;b&gt;entry 1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;seq 1 · HLC time&lt;br&gt;prev = h₀&lt;br&gt;decision: allow pmu-b1-1 write bay-1/telemetry&lt;br&gt;hash = SHA-256(prev ‖ canonical JSON)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;spacingLeft=10;" vertex="1" parent="p2-1">
          <mxGeometry x="440" y="143.0" width="360" height="169.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-auditlog-3" value="h₀" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p2-1" source="p2-e0" target="p2-e1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e2" value="&lt;b&gt;entry 2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;seq 2 · HLC time&lt;br&gt;prev = h₁&lt;br&gt;signal: behaviour 1.0 for pmu-b1-3&lt;br&gt;hash = SHA-256(prev ‖ canonical JSON)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;spacingLeft=10;" vertex="1" parent="p2-1">
          <mxGeometry x="860" y="143.0" width="360" height="169.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-auditlog-4" value="h₁" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p2-1" source="p2-e1" target="p2-e2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e3" value="&lt;b&gt;entry 3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;seq 3 · HLC time&lt;br&gt;prev = h₂&lt;br&gt;compromise: pmu-b1-3, epoch 7 → 8&lt;br&gt;hash = SHA-256(prev ‖ canonical JSON)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;spacingLeft=10;" vertex="1" parent="p2-1">
          <mxGeometry x="1280" y="143.0" width="360" height="169.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-auditlog-5" value="h₂" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p2-1" source="p2-e2" target="p2-e3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-auditlog-6" value="&lt;b&gt;Tampering is detected&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;an attacker edits entry 2 (&quot;behaviour 0.1&quot;): its hash changes, entry 3 still says prev = h₂ (old value) → verification fails at seq 3 and names it&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;align=left;spacingLeft=10;" vertex="1" parent="p2-1">
          <mxGeometry x="860" y="364.0" width="400" height="117.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-auditlog-7" value="&lt;b&gt;Operations&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;&lt;b&gt;ztcctl audit verify&lt;/b&gt;: recompute every hash from genesis&lt;/li&gt;&lt;li&gt;&lt;b&gt;restart&lt;/b&gt;: OpenFile reads the JSONL and continues from the last hash so a restart never breaks the chain&lt;/li&gt;&lt;li&gt;&lt;b&gt;HLC timestamps&lt;/b&gt; (M3): logs from several nodes merge in causal order&lt;/li&gt;&lt;li&gt;&lt;b&gt;export&lt;/b&gt;: syslog to a SIEM, where a copy lives outside the attacker's reach&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="364.0" width="800" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-auditlog-8" value="&lt;b&gt;Known limit and mitigation&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;an attacker with write access to the whole file can rebuild the entire chain&lt;/li&gt;&lt;li&gt;mitigation: anchor the head hash elsewhere (SIEM, Raft log, signed checkpoints)&lt;/li&gt;&lt;li&gt;the log is evidence, not prevention: detection and accountability (STRIDE R)&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="520.0" width="800" height="117.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-auditlog-9" value="&lt;b&gt;Why a hash chain and not a database?&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;append-only by construction, verifiable with 30 lines of Go&lt;/li&gt;&lt;li&gt;no extra service in the trust path&lt;/li&gt;&lt;li&gt;same idea as certificate transparency and git, without a Merkle tree (not needed at this size)&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="860" y="520.0" width="840" height="117.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>