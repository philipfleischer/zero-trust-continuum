<mxfile host="app.diagrams.net" agent="ztc-diagram-generator" type="device">
  <diagram name="Credential models (RQ2)" id="page-0">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1060" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p0-0" />
        <mxCell id="p0-1" parent="p0-0" />
        <mxCell id="p0-credenti-1" value="Three credential models, one PEP (RQ2)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="10" width="1600" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-2" value="The PEP accepts all three, so the same request path can be measured with each. Authentication strength feeds the trust score: stronger credentials keep a subject at high trust for longer." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="44" width="1600" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p0-col0" value="Bearer token (JWT-like)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#1f3a5f;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="100" width="545" height="600" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-3" value="M1 · strength 0.5" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;align=right;fontSize=11;fontStyle=0;" vertex="1" parent="p0-col0">
          <mxGeometry x="300" y="6" width="235" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p0-col1" value="Capability (macaroon-like)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#2d4d1f;" vertex="1" parent="p0-1">
          <mxGeometry x="585" y="100" width="545" height="600" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-4" value="M1 · strength 0.6" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;align=right;fontSize=11;fontStyle=0;" vertex="1" parent="p0-col1">
          <mxGeometry x="300" y="6" width="235" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p0-col2" value="X.509-SVID over mTLS" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#4b2a5c;" vertex="1" parent="p0-1">
          <mxGeometry x="1150" y="100" width="545" height="600" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-5" value="M5 · strength 0.8 (1.0 with attestation)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;align=right;fontSize=11;fontStyle=0;" vertex="1" parent="p0-col2">
          <mxGeometry x="300" y="6" width="235" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-6" value="&lt;b&gt;header&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;{&quot;alg&quot;:&quot;EdDSA&quot;,&quot;kid&quot;:…}&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-col0">
          <mxGeometry x="20" y="45" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-7" value="&lt;b&gt;claims&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;sub, aud, exp, nbf, jti, scope&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-col0">
          <mxGeometry x="190" y="45" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-8" value="&lt;b&gt;signature&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Ed25519(header.claims)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-col0">
          <mxGeometry x="370" y="45" width="155" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-9" value="&lt;b&gt;Issue&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;ztc-ca signs with its Ed25519 key&lt;/li&gt;&lt;li&gt;TTL minutes; device renews before expiry&lt;/li&gt;&lt;li&gt;kid = key thumbprint (rotation)&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;" vertex="1" parent="p0-col0">
          <mxGeometry x="20" y="125" width="505" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-10" value="&lt;b&gt;Verify at the PEP&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;alg pinned to EdDSA: alg=none and alg confusion rejected&lt;/li&gt;&lt;li&gt;signature with the CA public key (GET /v1/keys)&lt;/li&gt;&lt;li&gt;exp / nbf with small clock-skew allowance, aud = this PEP&lt;/li&gt;&lt;li&gt;jti not on the revocation list&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;" vertex="1" parent="p0-col0">
          <mxGeometry x="20" y="230" width="505" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-11" value="&lt;b&gt;+&lt;/b&gt; stateless, offline verification, familiar to every developer&lt;br&gt;&lt;b&gt;−&lt;/b&gt; bearer: whoever holds it can use it; revocation needs a list or short TTL; one signature verify per request" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p0-col0">
          <mxGeometry x="20" y="370" width="505" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-12" value="&lt;span style=&quot;font-size:11px&quot;&gt;Interview question: &lt;i&gt;how do you revoke a token that is valid for 5 more minutes?&lt;/i&gt; Short TTLs + revocation list keyed by jti + an epoch counter that tells every cache to drop its decisions.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;" vertex="1" parent="p0-col0">
          <mxGeometry x="20" y="475" width="505" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p0-capk" value="&lt;span style=&quot;font-size:11px&quot;&gt;root key K&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-col1">
          <mxGeometry x="20" y="45" width="200" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p0-capid" value="&lt;span style=&quot;font-size:11px&quot;&gt;id + location&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-col1">
          <mxGeometry x="20" y="97" width="200" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-13" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-capk" target="p0-capid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-capc1" value="&lt;span style=&quot;font-size:11px&quot;&gt;caveat: action = execute&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-col1">
          <mxGeometry x="20" y="149" width="200" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-14" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-capid" target="p0-capc1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-capc2" value="&lt;span style=&quot;font-size:11px&quot;&gt;caveat: task = 42&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-col1">
          <mxGeometry x="20" y="201" width="200" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-15" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-capc1" target="p0-capc2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-capc3" value="&lt;span style=&quot;font-size:11px&quot;&gt;caveat: expires &amp;lt; t+30 s&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-col1">
          <mxGeometry x="20" y="253" width="200" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-16" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-capc2" target="p0-capc3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-17" value="&lt;span style=&quot;font-size:11px&quot;&gt;sig₀ = HMAC(K, id)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;fontFamily=Courier New;" vertex="1" parent="p0-col1">
          <mxGeometry x="250" y="97" width="275" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-18" value="&lt;span style=&quot;font-size:11px&quot;&gt;sig₁ = HMAC(sig₀, caveat₁)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;fontFamily=Courier New;" vertex="1" parent="p0-col1">
          <mxGeometry x="250" y="149" width="275" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-19" value="&lt;span style=&quot;font-size:11px&quot;&gt;sig₂ = HMAC(sig₁, caveat₂)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;fontFamily=Courier New;" vertex="1" parent="p0-col1">
          <mxGeometry x="250" y="201" width="275" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-20" value="&lt;span style=&quot;font-size:11px&quot;&gt;sig₃ = HMAC(sig₂, caveat₃)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;fontFamily=Courier New;" vertex="1" parent="p0-col1">
          <mxGeometry x="250" y="253" width="275" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-21" value="&lt;b&gt;Attenuate offline&lt;/b&gt;: anyone holding a capability can add a caveat and compute the next HMAC, but nobody can remove one without K. Verification recomputes the chain and checks every caveat (StandardChecker: action, resource, task, layer, expiry)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;" vertex="1" parent="p0-col1">
          <mxGeometry x="20" y="315" width="505" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-22" value="&lt;b&gt;+&lt;/b&gt; HMAC is far cheaper than a signature; natural delegation along an offloading chain (fog A narrows the capability before handing it to fog B)&lt;br&gt;&lt;b&gt;−&lt;/b&gt; symmetric root key: the verifier must hold K; still bearer" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p0-col1">
          <mxGeometry x="20" y="420" width="505" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-23" value="&lt;span style=&quot;font-size:11px&quot;&gt;Used for: task offloading and delegation between fog nodes (M4), cheap checks on constrained devices.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;" vertex="1" parent="p0-col1">
          <mxGeometry x="20" y="530" width="505" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-24" value="&lt;b&gt;SPIFFE ID in the URI SAN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;spiffe://grid.example/edge/pmu/pmu-b1-1&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-col2">
          <mxGeometry x="20" y="45" width="505" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-25" value="&lt;b&gt;Issue&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;key pair generated on the device; CSR + join token to ztc-ca&lt;/li&gt;&lt;li&gt;ECDSA P-256 certificate, TTL minutes to hours&lt;/li&gt;&lt;li&gt;renewed automatically at 2/3 of its lifetime&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;" vertex="1" parent="p0-col2">
          <mxGeometry x="20" y="115" width="505" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-26" value="&lt;b&gt;Verify&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;TLS 1.3 handshake, client certificate required&lt;/li&gt;&lt;li&gt;VerifyConnection: chain to the trust bundle, trust domain, SPIFFE ID shape, expiry&lt;/li&gt;&lt;li&gt;identity → inventory → roles, zone&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;" vertex="1" parent="p0-col2">
          <mxGeometry x="20" y="215" width="505" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-27" value="&lt;b&gt;+&lt;/b&gt; proof of possession (key never leaves the device), encrypts the channel too, one handshake per session&lt;br&gt;&lt;b&gt;−&lt;/b&gt; revocation is hard while a session lives: a revoked device keeps its open connection unless the PEP tears sessions down" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p0-col2">
          <mxGeometry x="20" y="330" width="505" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-28" value="&lt;span style=&quot;font-size:11px&quot;&gt;Design rule: sessions are bounded by the certificate TTL and torn down on revocation, so long sessions cannot outlive a compromise.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;" vertex="1" parent="p0-col2">
          <mxGeometry x="20" y="440" width="505" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-29" value="&lt;b&gt;Comparison (expected trade-offs, measured in RQ2)&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Token&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Capability&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;mTLS SVID&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;PEP cost per request&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;1 signature verify&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;a few HMACs&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;≈ 0 inside a session (handshake once)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;Proof of possession&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;no (bearer)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;no (bearer)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;Delegation / attenuation&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;re-issue at the CA&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;offline, by the holder&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;no&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;Revocation latency&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;≤ TTL or list poll&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;≤ expiry caveat or list poll&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;session teardown needed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;Fits&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;operators, APIs&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;offloaded tasks, constrained devices&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;service-to-service, devices with a secure key store&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=11;overflow=fill;fontColor=#222222;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="720" width="1680" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p0-credenti-30" value="&lt;b&gt;Why support all three?&lt;/b&gt; The thesis question is which fits a dynamic continuum. A single PEP with three authenticators keeps everything else equal, so differences in latency, CPU and revocation window come from the credential alone. The production answer is likely a mix: mTLS between services, capabilities for delegated tasks, tokens for humans." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="905" width="1680" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Trust algorithm (RQ4)" id="page-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="980" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p1-0" />
        <mxCell id="p1-1" parent="p1-0" />
        <mxCell id="p1-trustalg-1" value="Continuous trust: signals → score → policy" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="10" width="1600" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p1-trustalg-2" value="NIST SP 800-207 trust algorithm, score-based and contextual. The PDP writes the score into context.trustScore before the policy is evaluated, so trust thresholds live in ordinary policy conditions." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="44" width="1600" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1-pep_s" value="&lt;b&gt;PEP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;authentication (0.5 / 0.6 / 0.8 / 1.0)&lt;br&gt;location (expected zone 1, else 0)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="110" width="280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p1-att_s" value="&lt;b&gt;Attestation (M5)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;posture (1 patched + attested, 0 unknown)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="215" width="280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p1-ids_s" value="&lt;b&gt;IDS (M2)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;behaviour: anomaly score 0 … 1&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="320" width="280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p1-pdp_s" value="&lt;b&gt;PDP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;denial on every deny; compromise on behaviour ≥ 0.9 or SOC&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="425" width="280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p1-store" value="&lt;b&gt;trust.Store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;map subject → State, mutex, injectable clock; unknown kind or empty subject rejected; values clamped to [0, 1]&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="370" y="230" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p1-trustalg-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-pep_s" target="p1-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-trustalg-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-att_s" target="p1-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-trustalg-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-ids_s" target="p1-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-trustalg-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-pdp_s" target="p1-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-formula" value="&lt;b&gt;Score(subject, now)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:12px&quot;&gt;auth = strength · 0.5^((now − lastAuth) / 5 min)&lt;br&gt;&lt;br&gt;score = 0.35·auth&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ 0.25·posture&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ 0.30·(1 − anomaly)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ 0.10·location&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;− 0.1 · denials · 0.5^(Δt / 10 min)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;anomaly, location: EWMA with α = 0.5&lt;br&gt;compromised ⇒ 0 · never authenticated ⇒ 0 · NaN ⇒ 0 · clamp [0, 1]&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p1-1">
          <mxGeometry x="700" y="140" width="420" height="240" as="geometry" />
        </mxCell>
        <mxCell id="p1-trustalg-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p1-1" source="p1-store" target="p1-formula">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-lv0" value="&lt;b&gt;high&lt;/b&gt; ≥ 0.8&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;operate breaker, admin policy&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="1190" y="120" width="300" height="68" as="geometry" />
        </mxCell>
        <mxCell id="p1-lv1" value="&lt;b&gt;medium&lt;/b&gt; ≥ 0.5&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;read telemetry, run tasks (migrate needs 0.7)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="1190" y="202" width="300" height="68" as="geometry" />
        </mxCell>
        <mxCell id="p1-lv2" value="&lt;b&gt;low&lt;/b&gt; ≥ 0.3&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;above the zero-trust floor&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;fontColor=#222222;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="1190" y="284" width="300" height="68" as="geometry" />
        </mxCell>
        <mxCell id="p1-lv3" value="&lt;b&gt;untrusted&lt;/b&gt; &amp;lt; 0.3&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;deny everything (deny-untrusted)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;fontColor=#222222;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="1190" y="366" width="300" height="68" as="geometry" />
        </mxCell>
        <mxCell id="p1-trustalg-8" value="context.trustScore" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-formula" target="p1-lv1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-pol" value="&lt;b&gt;Policy conditions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;context.trustScore gte 0.8 …&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="1530" y="210" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1-trustalg-9" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-lv1" target="p1-pol">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-trustalg-10" value="&lt;b&gt;Step-up authentication falls out of the formula&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Credential&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Score right after&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Stays ≥ 0.8 (high) for&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;bearer token (0.5)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;0.825&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;≈ 67 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;capability (0.6)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;0.86&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;≈ 146 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;mTLS (0.8)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;0.93&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;≈ 270 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;mTLS + attestation (1.0)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;1.0&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;≈ 367 s&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Posture 1, location 1, no anomaly. An operator who wants to switch a breaker must have authenticated recently, and a stronger credential buys a longer window. Neither the formula nor the policy has a special rule for it.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=11;overflow=fill;fontColor=#222222;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="560" width="640" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p1-trustalg-11" value="&lt;b&gt;Compromise path&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;IDS behaviour signal ≥ 0.9 → PDP marks the subject compromised&lt;/li&gt;&lt;li&gt;score pinned to 0 for good (only an operator can clear it)&lt;/li&gt;&lt;li&gt;revocation epoch + 1 → every decision cache flushes&lt;/li&gt;&lt;li&gt;audit entry written; Prometheus alert fires&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;fontColor=#222222;spacing=4;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="700" y="560" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1-trustalg-12" value="&lt;b&gt;Why these weights?&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;authentication and behaviour weigh most: the only signals that change within seconds&lt;/li&gt;&lt;li&gt;posture changes slowly; location is weak evidence where devices never move&lt;/li&gt;&lt;li&gt;weights sum to 1, so the score stays interpretable&lt;/li&gt;&lt;li&gt;a starting point, not a result: RQ4 varies them&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="1160" y="560" width="540" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1-trustalg-13" value="&lt;b&gt;One formula, two implementations&lt;/b&gt;: services/internal/trust (Go) and sim/core/trust_model (C++) share the same hand-computed test vectors, so a simulated result can be checked against the running system." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="700" y="735" width="1000" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Cache and revocation" id="page-2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p2-0" />
        <mxCell id="p2-1" parent="p2-0" />
        <mxCell id="p2-cacheand-1" value="Decision cache: fast, but never allowed to outlive a trust change" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="10" width="1600" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p2-cacheand-2" value="A cache in a zero-trust system is a stored, possibly stale decision. Every entry carries the versions it was decided under, and anything that lowers trust invalidates it." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="44" width="1600" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p2-pep" value="&lt;b&gt;PEP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;decide(request)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="160" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-cachec" value="Decision cache (fog)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#2d4d1f;" vertex="1" parent="p2-1">
          <mxGeometry x="230" y="100" width="640" height="420" as="geometry" />
        </mxCell>
        <mxCell id="p2-cacheand-3" value="&lt;b&gt;key&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;(subject, action, resource)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p2-cachec">
          <mxGeometry x="20" y="45" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-cacheand-4" value="&lt;b&gt;entry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;decision · expires · policyVersion · revocationEpoch&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p2-cachec">
          <mxGeometry x="230" y="45" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-cacheand-5" value="&lt;b&gt;Lookup returns a hit only if all hold&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;now &amp;lt; expires (TTL from the rule, emergency 1 s)&lt;/li&gt;&lt;li&gt;entry.policyVersion = latest seen policy version&lt;/li&gt;&lt;li&gt;entry.revocationEpoch = latest seen revocation epoch&lt;/li&gt;&lt;li&gt;decision was an allow (denies are never cached)&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;" vertex="1" parent="p2-cachec">
          <mxGeometry x="20" y="125" width="600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-cacheand-6" value="&lt;b&gt;Invalidation triggers&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Trigger&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Action&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;TTL expired&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;entry dropped on lookup&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;new policy version observed&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;all entries dropped (separate counter)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;revocation epoch increased&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;all entries dropped (separate counter)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;upstream denies any request of subject S&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;all entries of S dropped (invalidate-on-deny)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;size limit reached&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;oldest entry evicted&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=11;overflow=fill;fontColor=#222222;" vertex="1" parent="p2-cachec">
          <mxGeometry x="20" y="255" width="600" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2-pdp" value="&lt;b&gt;PDP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Decision{…, policyVersion, revocationEpoch}&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p2-1">
          <mxGeometry x="960" y="160" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-revs" value="&lt;b&gt;GET /v1/revocations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;polled every 2 s; returns the current epoch&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p2-1">
          <mxGeometry x="960" y="300" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-cacheand-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.21;entryDx=0;entryDy=0;" edge="1" parent="p2-1" source="p2-pep" target="p2-cachec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-cacheand-8" value="miss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p2-1" source="p2-cachec" target="p2-pdp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-cacheand-9" value="epoch ↑ ⇒ flush" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#6c8ebf;fontColor=#1f3a5f;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.67;entryDx=0;entryDy=0;" edge="1" parent="p2-1" source="p2-revs" target="p2-cachec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-cacheand-10" value="&lt;b&gt;Why invalidate-on-deny matters (the RQ4 lesson)&lt;/b&gt;&lt;br&gt;A compromised device first tries lateral movement and breaker commands. Those are denied, and each denial lowers its trust at the PDP until even its telemetry would be denied. A naive cache keeps serving the old telemetry allow and so &lt;b&gt;bypasses the trust decay&lt;/b&gt;. Dropping all cached entries of a subject on any deny closes that gap for the cost of one extra PDP round trip." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;fontColor=#222222;spacing=4;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="1240" y="100" width="460" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p2-cacheand-11" value="&lt;b&gt;General rule&lt;/b&gt;: every cache in a zero-trust system must be invalidated by trust changes, not only by policy and revocation events. Next step: a per-subject trust epoch pushed by the PDP." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="1240" y="350" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-cacheand-12" value="&lt;b&gt;Staleness budget&lt;/b&gt;&lt;br&gt;unauthorized window = detection delay + signal transport + cache staleness. Cache staleness ≤ min(TTL, revocation poll interval). Short TTLs on dangerous actions keep the worst case small." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="560" width="850" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-cacheand-13" value="&lt;b&gt;Design choice: pull, not push (for now)&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;polling an epoch is one tiny GET, works through NAT and the DMZ, and degrades gracefully during a partition (the PEP knows it is stale)&lt;/li&gt;&lt;li&gt;push (server-sent events) would cut the window to the network delay; noted for later&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="920" y="560" width="780" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>