        <mxCell id="p1-k8s" value="&lt;b&gt;Kubernetes NetworkPolicies&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;deploy/k8s/reference/networkpolicies-zones.yaml · default deny + one policy per conduit&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="920" y="110" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-onemodel-5" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-exp" target="p1-k8s">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-cisco" value="&lt;b&gt;Cisco extended ACLs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;deploy/network/cisco/generated-zone-acls.ios · ZTC-IN-&amp;lt;zone&amp;gt; on the core switch SVIs&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="920" y="245" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-onemodel-6" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-exp" target="p1-cisco">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-docker" value="&lt;b&gt;Docker Compose networks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;one network per zone; services attached only where a conduit exists&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="920" y="380" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-onemodel-7" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-exp" target="p1-docker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-tf" value="&lt;b&gt;OpenStack security groups&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Terraform on NREC: one security group per zone, rules per conduit&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="920" y="515" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-onemodel-8" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-exp" target="p1-tf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-onemodel-9" value="&lt;b&gt;CI drift check&lt;/b&gt;: regenerate and git diff --exit-code, so a hand edit of a generated file fails the build." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="1330" y="110" width="370" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-onemodel-10" value="&lt;b&gt;Why both ACLs and a PEP?&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Layer&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Decides&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Granularity&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Changes&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;ACL / NetworkPolicy / SG&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;which hosts may talk on which ports&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;L3/L4, static&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;on deploy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;PEP + PDP&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;which authenticated identity may do what, now&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;L7, per request, trust-aware&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;every second&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Zero trust needs both: the network layer shrinks the attack surface, the identity layer makes the decision. Defence in depth, not either-or.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=11;overflow=fill;fontColor=#222222;" vertex="1" parent="p1-1">
          <mxGeometry x="1330" y="240" width="370" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p1-onemodel-11" value="&lt;b&gt;Exercise built into the design&lt;/b&gt;: add a historian server to the DMZ in the Go model, regenerate, and all four layers pick it up consistently." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="600" width="780" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
