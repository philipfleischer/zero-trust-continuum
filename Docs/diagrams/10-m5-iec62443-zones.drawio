        </mxCell>
        <mxCell id="p0-zonesand-23" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=mxgraph.basic.x;fillColor=#b85450;strokeColor=none;" vertex="1" parent="p0-1">
          <mxGeometry x="1046" y="440" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p0-zonesand-24" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;rejected by Validate()&lt;/b&gt;&lt;br&gt;process-bus → control-centre skips Purdue levels and does not end in the DMZ&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;fontColor=#b85450;" vertex="1" parent="p0-1">
          <mxGeometry x="1080" y="410" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p0-zonesand-25" value="&lt;b&gt;Validation rules (enforced in code, unit-tested)&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;zone names unique; conduits only between known zones&lt;/li&gt;&lt;li&gt;every conduit restricts protocols and ports (no any/any)&lt;/li&gt;&lt;li&gt;no conduit skips a Purdue level unless it ends in the DMZ&lt;/li&gt;&lt;li&gt;conduits into a zone with SL-T ≥ 3 must be encrypted&lt;/li&gt;&lt;li&gt;the model fails to load if any rule is broken (fail closed)&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p0-1">
          <mxGeometry x="1320" y="100" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p0-zonesand-26" value="&lt;b&gt;Security levels&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;SL&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Protects against&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;casual or accidental violation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;intentional, simple means, low resources&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;sophisticated means, moderate resources, IACS skills&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;sophisticated means, extended resources (nation state)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=11;overflow=fill;fontColor=#222222;" vertex="1" parent="p0-1">
          <mxGeometry x="1320" y="320" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p0-zonesand-27" value="&lt;b&gt;IEC 62443-3-3 foundational requirements → ZTC&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;FR&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Mechanism&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;FR1 Identification and authentication&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;SPIFFE IDs, CA, tokens, 802.1X&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;FR2 Use control&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;ABAC policy, least privilege, audit (SR 2.8)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;FR3 System integrity&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;signed tokens, sealed migration state, GOOSE validation, distroless images&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;FR4 Data confidentiality&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;TLS / mTLS, IPsec, AES-GCM&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;FR5 Restricted data flow&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;zones and conduits → NetworkPolicies, ACLs, zone-based firewall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;FR6 Timely response to events&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;IDS, audit log, alert rules, incident runbook&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;FR7 Resource availability&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;Raft PDP, fog placement, PDB, storm control, CoPP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=11;overflow=fill;fontColor=#222222;" vertex="1" parent="p0-1">
          <mxGeometry x="1060" y="530" width="640" height="290" as="geometry" />
        </mxCell>
        <mxCell id="p0-zonesand-28" value="&lt;span style=&quot;font-size:11px&quot;&gt;SL-T 3 for protection and control zones is the usual target for substations; the DMZ and enterprise zones are SL-T 2 because they hold no control functions and are separated by the DMZ.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="860" width="1000" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="One model, four layers" id="page-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="820" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p1-0" />
        <mxCell id="p1-1" parent="p1-0" />
        <mxCell id="p1-onemodel-1" value="M5 — one zone model, exported to every enforcement layer (ADR 0006)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="10" width="1600" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p1-onemodel-2" value="Writing the same rules by hand in YAML, IOS and HCL drifts. Here the Go model is the single source; generated files are committed and CI fails if they are out of date." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="44" width="1600" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1-model" value="&lt;b&gt;segment.SubstationModel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;zones, Purdue level, SL-T, assets; conduits with protocols, ports, encryption&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="300" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-val" value="&lt;b&gt;Validate()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;the rules from the previous page&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;rounded=1;" vertex="1" parent="p1-1">
          <mxGeometry x="380" y="315" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-exp" value="&lt;b&gt;ztcctl segment export&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;make netpol&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
