        <mxCell id="p0-pdpplace-21" value="&lt;span style=&quot;font-size:15px&quot;&gt;WAN partition&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;fontColor=#b85450;fontStyle=1;" vertex="1" parent="p0-opt2">
