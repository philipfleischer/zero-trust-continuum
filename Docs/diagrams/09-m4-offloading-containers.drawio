        <mxCell id="p2-kubernet-13" value="8443 (allowed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p2-1" source="p2-kedge" target="p2-kpep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-kubernet-14" value="9000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p2-1" source="p2-kpep" target="p2-kfog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-kubernet-15" value="8181" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p2-1" source="p2-kpep" target="p2-sts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-kubernet-16" value="&lt;b&gt;NetworkPolicies&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;&lt;b&gt;default-deny&lt;/b&gt;: podSelector {} with no ingress / egress rules&lt;/li&gt;&lt;li&gt;&lt;b&gt;allow-dns&lt;/b&gt; egress to kube-dns only&lt;/li&gt;&lt;li&gt;&lt;b&gt;one policy per conduit&lt;/b&gt;, generated by ztcctl segment export k8s from the Go zone model&lt;/li&gt;&lt;li&gt;fog ingress only from the PEP (TB2 enforced by the cluster, not by trust in headers)&lt;/li&gt;&lt;li&gt;CI check fails if the generated YAML is out of date&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="1230" y="130.0" width="470" height="208.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-kubernet-17" value="&lt;b&gt;Kustomize overlays&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:15px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Overlay&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Target&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Differences&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;dev&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;kind + Calico&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;1 node, local images&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;edge&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;k3s on NREC VMs / Raspberry Pi&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;arm64, fog taints, real storage class&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Helm chart&lt;/b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;: replicas, placement, TLS as values; helm lint + template in CI&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=15;overflow=fill;fontColor=#222222;" vertex="1" parent="p2-1">
          <mxGeometry x="1230" y="364.0" width="470" height="182.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-kubernet-18" value="&lt;b&gt;Failure drill (IN5700)&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;kubectl delete pod ztc-pdp-0 → new Raft leader, decisions continue&lt;/li&gt;&lt;li&gt;kubectl exec ztc-edge → wget ztc-pdp:8181 times out (policy proof)&lt;/li&gt;&lt;li&gt;PDB blocks a drain that would lose the Raft majority&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="1230" y="572.0" width="470" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-kubernet-19" value="&lt;b&gt;Why a StatefulSet for the PDP?&lt;/b&gt; Raft needs stable identities (ztc-pdp-0..2 resolve via the headless Service) and durable per-replica storage (PVC). A Deployment would give random names and shared or no storage." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="1230" y="728.0" width="470" height="117.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
