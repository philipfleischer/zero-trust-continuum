          <mxGeometry x="375" y="52.0" width="165" height="91.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-kubernet-6" value="&lt;span style=&quot;font-size:15px&quot;&gt;PodDisruptionBudget minAvailable 2 · podAntiAffinity: one replica per node · readiness /readyz (raft-leader known)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;" vertex="1" parent="p2-sts">
          <mxGeometry x="15" y="162.5" width="530" height="65.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-kubernet-7" value="&lt;span style=&quot;font-size:15px&quot;&gt;ConfigMap ztc-policy ← deploy/policies/substation.json (test keeps copies identical)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;" vertex="1" parent="p2-sts">
          <mxGeometry x="15" y="221.0" width="530" height="52.0" as="geometry" />
