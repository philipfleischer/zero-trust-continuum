        <mxCell id="p2-kubernet-11" value="&lt;span style=&quot;font-size:15px&quot;&gt;securityContext on every pod: runAsNonRoot, readOnlyRootFilesystem, allowPrivilegeEscalation false, capabilities drop ALL, seccompProfile RuntimeDefault; probes on /healthz and /readyz&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;" vertex="1" parent="p2-zcc">
