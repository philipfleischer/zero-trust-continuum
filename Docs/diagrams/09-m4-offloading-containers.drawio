        </mxCell>
        <mxCell id="p1-dockerco-2" value="A container joins only the networks it needs. A container on two networks is a conduit; everything else is unreachable by construction (ot-dmz is internal: no route to the internet)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=18;fontColor=#555555;" vertex="1" parent="p1-1">
