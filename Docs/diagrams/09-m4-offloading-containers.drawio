        <mxCell id="p1-dockerco-38" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;ellipse;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="p1-1">
          <mxGeometry x="1568" y="718.3" width="14" height="15.4" as="geometry" />
        </mxCell>
        <mxCell id="p1-dockerco-39" value="&lt;b&gt;Hardened defaults on every service (YAML anchor)&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:16px&quot;&gt;&lt;li&gt;read_only root filesystem, tmpfs for /tmp&lt;/li&gt;&lt;li&gt;cap_drop: [ALL], no-new-privileges&lt;/li&gt;&lt;li&gt;memory and CPU limits&lt;/li&gt;&lt;li&gt;distroless static image, non-root uid 65532&lt;/li&gt;&lt;li&gt;healthcheck = the binary's own healthcheck subcommand (no shell, no curl)&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=16;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="792.0" width="560" height="165.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-dockerco-40" value="&lt;b&gt;Isolation is tested, not assumed&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:16px&quot;&gt;&lt;li&gt;scripts/zone-check.sh runs inside the containers&lt;/li&gt;&lt;li&gt;ztc-edge → ztc-pdp must fail (no shared network)&lt;/li&gt;&lt;li&gt;ztc-edge → ztc-fog must fail (only the PEP reaches the fog: TB2)&lt;/li&gt;&lt;li&gt;ztc-pep → ztc-fog must succeed&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=16;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="600" y="792.0" width="520" height="165.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-dockerco-41" value="&lt;b&gt;Known simplifications&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:16px&quot;&gt;&lt;li&gt;Docker networks are L3 segments, not a firewall: no port filtering inside a network&lt;/li&gt;&lt;li&gt;the CA is reachable from the station bus for enrolment&lt;/li&gt;&lt;li&gt;Kubernetes NetworkPolicies (next page) add port-level rules&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=17;fontColor=#222222;spacing=4;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="1140" y="792.0" width="560" height="165.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Kubernetes" id="page-2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1248" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p2-0" />
        <mxCell id="p2-1" parent="p2-0" />
        <mxCell id="p2-kubernet-1" value="M4 — Kubernetes: default deny, generated NetworkPolicies, a StatefulSet PDP" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="13.0" width="1600" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="p2-kubernet-2" value="The same zones become pod labels. A default-deny policy blocks all traffic; one generated NetworkPolicy per conduit opens exactly the ports the zone model allows (needs a CNI that enforces policies, e.g. Calico)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=17;fontColor=#555555;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="57.2" width="1600" height="44.2" as="geometry" />
        </mxCell>
        <mxCell id="p2-ns" value="namespace ztc  ·  pod-security.kubernetes.io/enforce: restricted" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=18;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="130.0" width="1180" height="949.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-zcc" value="zone=control-centre" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=18;fontColor=#1f3a5f;" vertex="1" parent="p2-ns">
          <mxGeometry x="20" y="52.0" width="1140" height="364.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-sts" value="StatefulSet ztc-pdp  (headless Service → stable Raft peer names)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=3;container=1;collapsible=0;recursiveResize=0;fillColor=#ffffff;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=16;fontColor=#333333;" vertex="1" parent="p2-zcc">
