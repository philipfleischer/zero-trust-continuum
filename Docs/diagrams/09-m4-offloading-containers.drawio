<mxfile host="app.diagrams.net" agent="ztc-diagram-generator" type="device">
  <diagram name="Trust-aware offloading" id="page-0">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1200" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p0-0" />
        <mxCell id="p0-1" parent="p0-0" />
        <mxCell id="p0-trustawa-1" value="M4 — trust-aware computation offloading" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="10" width="1680" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p0-trustawa-2" value="A fog node decides where to run a task by cost: latency, energy and risk, where risk = 1 − trust of the target. A fast but untrusted node is never chosen. The task carries an attenuated capability, not the caller's full credential." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=19;fontColor=#555555;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="52" width="1680" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p0-trustawa-3" value="CLOUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=20;fontColor=#1f3a5f;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="115" width="1680" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p0-cl" value="&lt;b&gt;cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;RTT 40 ms · plenty of CPU · trust 0.95&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=18;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-trustawa-3">
          <mxGeometry x="630" y="45" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p0-trustawa-4" value="FOG — substation" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=20;fontColor=#2d4d1f;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="300" width="1680" height="440" as="geometry" />
        </mxCell>
        <mxCell id="p0-C" value="&lt;b&gt;fog-C&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;load 5 % · RTT 2 ms · trust 0.41  ✘ below threshold&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=18;fontColor=#222222;spacing=4;" vertex="1" parent="p0-trustawa-4">
          <mxGeometry x="20" y="50" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p0-D" value="&lt;b&gt;fog-D&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;suspect in SWIM  ✘ skipped&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=18;fontColor=#222222;spacing=4;" vertex="1" parent="p0-trustawa-4">
          <mxGeometry x="360" y="50" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p0-B" value="&lt;b&gt;fog-B&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;load 30 % · RTT 3 ms · trust 0.92  ✔ chosen&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=18;fontColor=#222222;spacing=4;" vertex="1" parent="p0-trustawa-4">
          <mxGeometry x="980" y="50" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p0-capb" value="&lt;b&gt;delegated capability&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;fog-A appends caveats: target = fog-B, expires &amp;lt; t+30 s → fog-B can run task 42 and nothing else&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=18;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-trustawa-4">
          <mxGeometry x="1340" y="40" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p0-loc" value="&lt;b&gt;run locally on fog-A&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;queue 80 % · latency 45 ms · trust 1.0&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=18;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-trustawa-4">
          <mxGeometry x="20" y="275" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p0-A" value="&lt;b&gt;fog-A (receiving node)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;candidates = SWIM alive members ∪ {local, cloud}; filter: trust ≥ 0.5 (policy execute-task)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=18;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-trustawa-4">
          <mxGeometry x="630" y="260" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p0-cost" value="&lt;b&gt;cost(target) =&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:18px&quot;&gt;w_l · latency&lt;br&gt;+ w_e · energy&lt;br&gt;+ w_r · (1 − trust)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=18;fontColor=#222222;spacing=4;" vertex="1" parent="p0-trustawa-4">
          <mxGeometry x="1240" y="260" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p0-trustawa-5" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;strokeColor=#aaaaaa;" edge="1" parent="p0-1" source="p0-A" target="p0-loc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-trustawa-6" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;strokeColor=#aaaaaa;exitX=0.1;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-A" target="p0-C">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-trustawa-7" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;strokeColor=#aaaaaa;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-A" target="p0-D">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-trustawa-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;edgeStyle=none;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.4;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-A" target="p0-B">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-trustawa-9" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;strokeColor=#aaaaaa;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-A" target="p0-cl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-trustawa-10" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#6c8ebf;fontColor=#1f3a5f;dashed=1;" edge="1" parent="p0-1" source="p0-B" target="p0-capb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-trustawa-11" value="EDGE" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=20;fontColor=#6b4a00;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="770" width="1680" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p0-dev" value="&lt;b&gt;Edge device&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;POST /v1/tasks with capability (action=execute, task=42)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontSize=18;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-trustawa-11">
          <mxGeometry x="630" y="45" width="400" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p0-trustawa-12" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-dev" target="p0-A">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-trustawa-13" value="&lt;b&gt;Balancers compared (IN5700 T9)&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:17px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Balancer&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Idea&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Note&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;round-robin&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;next in turn&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;ignores load&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;least-loaded&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;minimum queue&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;needs fresh load info, herding&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;power-of-two-choices&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;sample 2, take the lighter&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;near-optimal with stale info&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;weighted least connections&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;connections / capacity&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;written as an exercise&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;trust-weighted&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;probability ∝ trust, threshold&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;proposed in this project&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=17;overflow=fill;fontColor=#222222;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="960" width="830" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p0-trustawa-14" value="&lt;b&gt;Design choices&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:17px&quot;&gt;&lt;li&gt;risk is part of the cost, not a filter only: among trusted nodes the more trusted one still wins ties&lt;/li&gt;&lt;li&gt;hard floor from policy (execute-task needs trust ≥ 0.5) so the cost model cannot be tuned into an unsafe choice&lt;/li&gt;&lt;li&gt;capabilities make delegation least-privilege: fog-B cannot reuse the token elsewhere&lt;/li&gt;&lt;li&gt;measured: balancers on a skewed workload, table test + benchmark&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=17;fontColor=#333333;" vertex="1" parent="p0-1">
          <mxGeometry x="870" y="960" width="830" height="215" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
