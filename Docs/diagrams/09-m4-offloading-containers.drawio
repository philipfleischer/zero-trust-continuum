        <mxCell id="p1-edge" value="&lt;b&gt;ztc-edge&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontSize=17;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
