        <mxCell id="p1-dockerco-1" value="M4 — Docker Compose: one network per IEC 62443 zone" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p1-1">
