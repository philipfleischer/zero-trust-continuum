        <mxCell id="p1-requests-35" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;the CA public key is fetched once; tokens verify offline at the PEP&lt;/li&gt;&lt;li&gt;the first authentication is sent synchronously, otherwise the very first decision would see trust 0&lt;/li&gt;&lt;li&gt;denies are never cached; allows are cached with TTL, policy version and revocation epoch&lt;/li&gt;&lt;li&gt;the upstream trusts X-ZTC-Subject only because the network lets nothing but the PEP reach it (TB2)&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="1306.5" width="1440" height="117.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Policy evaluation" id="page-2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1625" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p2-0" />
        <mxCell id="p2-1" parent="p2-0" />
        <mxCell id="p2-policyev-1" value="M1 — how a decision is made: ABAC with deny-overrides and default deny" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="13.0" width="1500" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="p2-a" value="&lt;b&gt;AccessRequest&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;subject · action · resource · context (trustScore, time, emergency, sourceZone)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;ellipse;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=15;fontStyle=1;fillColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="104.0" width="360" height="91.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-b" value="&lt;b&gt;Match every rule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;subjects (role:, spiffe:// glob) AND actions AND resources (type:, glob) AND all conditions true&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="247.0" width="360" height="104.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-c" value="any matching&lt;br&gt;&lt;b&gt;deny&lt;/b&gt; rule?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=15;" vertex="1" parent="p2-1">
          <mxGeometry x="120" y="403.0" width="200" height="143.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-d" value="DENY&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;deny-overrides: one deny beats any number of allows&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=16;fontStyle=1;" vertex="1" parent="p2-1">
          <mxGeometry x="420" y="422.5" width="260" height="104.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-e" value="any matching&lt;br&gt;&lt;b&gt;allow&lt;/b&gt; rule?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=15;" vertex="1" parent="p2-1">
          <mxGeometry x="120" y="598.0" width="200" height="143.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-f" value="DENY&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;default deny: no rule, no access (includes a trust condition that failed)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=16;fontStyle=1;" vertex="1" parent="p2-1">
          <mxGeometry x="420" y="617.5" width="260" height="104.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-g" value="ALLOW&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;+ obligations (log, rate-limit, reverify, alert) + TTL of the strictest matching rule&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontStyle=1;" vertex="1" parent="p2-1">
          <mxGeometry x="70" y="806.0" width="300" height="117.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-h" value="&lt;b&gt;PDP side effects&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;deny → denial signal lowers trust; every decision → audit; allow + TTL → cacheable&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p2-1">
          <mxGeometry x="420" y="812.5" width="260" height="104.0" as="geometry" />
        </mxCell>
        <mxCell id="p2-policyev-2" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p2-1" source="p2-a" target="p2-b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-policyev-3" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p2-1" source="p2-b" target="p2-c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-policyev-4" value="yes" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p2-1" source="p2-c" target="p2-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-policyev-5" value="no" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p2-1" source="p2-c" target="p2-e">
