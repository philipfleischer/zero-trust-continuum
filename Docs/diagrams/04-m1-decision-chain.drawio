<mxfile host="app.diagrams.net" agent="ztc-diagram-generator" type="device">
  <diagram name="PEP and PDP components" id="page-0">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1248" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p0-0" />
        <mxCell id="p0-1" parent="p0-0" />
        <mxCell id="p0-pepandpd-1" value="M1 — the decision chain: PEP → PDP (policy + trust)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="13.0" width="1600" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-2" value="The PEP never decides and the PDP never enforces (NIST SP 800-207 separation of duties). Every step fails closed: anything unknown, missing or unreachable becomes a deny." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=17;fontColor=#555555;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="57.2" width="1600" height="44.2" as="geometry" />
        </mxCell>
        <mxCell id="p0-client" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;device, operator or fog workload with a credential&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="182.0" width="150" height="104.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepc" value="ztc-pep  (fog)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=18;fontColor=#2d4d1f;" vertex="1" parent="p0-1">
          <mxGeometry x="200" y="130.0" width="615" height="1079.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-s1" value="&lt;b&gt;1  Route table&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;MatchRoute(path) → Resource{type, zone, layer, sensitivity}. Unknown route → 404: there is no default resource.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;spacingLeft=10;" vertex="1" parent="p0-pepc">
          <mxGeometry x="20" y="52.0" width="575" height="117.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-s2" value="&lt;b&gt;2  Authenticate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Strip inbound X-ZTC-* headers. Bearer token → Ed25519 verify (alg pinned, exp, nbf, aud, revoked jti); capability → HMAC chain + caveats; mTLS SVID (M5). Nothing valid → 401.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;spacingLeft=10;" vertex="1" parent="p0-pepc">
          <mxGeometry x="20" y="197.6" width="575" height="117.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-3" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-s1" target="p0-s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s3" value="&lt;b&gt;3  Trust signals&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;First authentication of a credential → synchronous authentication signal (0.5 token, 0.6 capability, 0.8 mTLS). Location signal: is the subject in its expected zone?&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;spacingLeft=10;" vertex="1" parent="p0-pepc">
          <mxGeometry x="20" y="343.2" width="575" height="117.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-4" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-s2" target="p0-s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s4" value="&lt;b&gt;4  Build request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;subject (id, roles, layer, zone, owner from inventory) · action (GET→read, POST→write, …) · resource · context (time, source zone)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;spacingLeft=10;" vertex="1" parent="p0-pepc">
          <mxGeometry x="20" y="488.8" width="575" height="117.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-5" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-s3" target="p0-s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s5" value="&lt;b&gt;5  Decider (placement, RQ1)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;cloud → RemoteClient · hierarchical → Cache → RemoteClient · fog → local PDP replica. Chosen with ZTC_PLACEMENT.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;spacingLeft=10;" vertex="1" parent="p0-pepc">
          <mxGeometry x="20" y="634.4" width="575" height="117.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-6" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-s4" target="p0-s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s6" value="&lt;b&gt;6  Enforce&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;allow → obligations (log, reverify, rate-limit) · deny → 403 · PDP error or timeout → 503 and deny (fail closed, ADR 0001)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;spacingLeft=10;" vertex="1" parent="p0-pepc">
          <mxGeometry x="20" y="780.0" width="575" height="117.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-7" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-s5" target="p0-s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s7" value="&lt;b&gt;7  Reverse proxy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;forward to the protected upstream with X-ZTC-Subject overwritten by the PEP; decision kept in the request context&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;spacingLeft=10;" vertex="1" parent="p0-pepc">
          <mxGeometry x="20" y="925.6" width="575" height="117.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-8" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p0-1" source="p0-s6" target="p0-s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-9" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-client" target="p0-s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-pdpc" value="ztc-pdp  (cloud, or fog replica)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=18;fontColor=#1f3a5f;" vertex="1" parent="p0-1">
          <mxGeometry x="900" y="130.0" width="800" height="1079.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-api" value="&lt;b&gt;HTTP API&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:15px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Read (open in M1)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Write (Bearer ZTC_PDP_TOKEN, constant-time; mTLS + policy-admin in M5)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;POST /v1/decide&lt;br&gt;GET /v1/trust&lt;br&gt;GET /v1/policy&lt;br&gt;GET /v1/revocations&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;POST /v1/signals&lt;br&gt;PUT /v1/policy&lt;br&gt;PUT /v1/emergency&lt;br&gt;POST /v1/revoke&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p0-pdpc">
          <mxGeometry x="20" y="52.0" width="760" height="156.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-decide" value="&lt;b&gt;PDP.Decide(request)&lt;/b&gt;&lt;ol style='margin:4px 0 0 0;padding-left:18px;font-size:15px'&gt;&lt;li&gt;stamp the request with PDP-owned time (callers cannot set it)&lt;/li&gt;&lt;li&gt;context.trustScore ← trust.Store.Score(subject, now)&lt;/li&gt;&lt;li&gt;context.emergency ← break-glass flag&lt;/li&gt;&lt;li&gt;policy.Engine.Evaluate → effect, rule, obligations, TTL&lt;/li&gt;&lt;li&gt;Decision{effect, rule, reason, ttl, obligations, policyVersion, revocationEpoch}&lt;/li&gt;&lt;li&gt;on deny: record a denial signal for the subject&lt;/li&gt;&lt;/ol&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p0-pdpc">
          <mxGeometry x="20" y="247.0" width="760" height="208.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-engine" value="&lt;b&gt;policy.Engine&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;ABAC, deny-overrides, default deny. atomic.Pointer → lock-free reads; Install() rejects invalid or stale versions and keeps the old policy&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;" vertex="1" parent="p0-pdpc">
          <mxGeometry x="20" y="507.0" width="360" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-tstore" value="&lt;b&gt;trust.Store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;per-subject state behind a mutex, injectable clock, decaying score (see 05)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;" vertex="1" parent="p0-pdpc">
          <mxGeometry x="420" y="507.0" width="360" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-rev" value="&lt;b&gt;Revocation list&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;revoked subjects / jti, epoch counter bumped on every revoke or compromise&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=15;" vertex="1" parent="p0-pdpc">
          <mxGeometry x="280" y="682.5" width="240" height="143.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-aud" value="&lt;b&gt;Audit log (M2)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;every decision, signal and compromise, hash-chained&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=15;" vertex="1" parent="p0-pdpc">
          <mxGeometry x="540" y="682.5" width="240" height="143.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-psrc" value="&lt;b&gt;Policy source&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;deploy/policies/substation.json (ZTC_POLICY_FILE) or built-in default; strict JSON, unknown fields rejected; canonical copy tested against the Go default&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-pdpc">
          <mxGeometry x="20" y="682.5" width="240" height="162.5" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-10" value="&lt;b&gt;Separation of duties&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:15px&quot;&gt;&lt;li&gt;PEP: authentication + enforcement, no policy knowledge&lt;/li&gt;&lt;li&gt;PDP: decision, no request bodies, never sees the upstream&lt;/li&gt;&lt;li&gt;a compromised PEP can lie about one request, but cannot change policy or trust&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;" vertex="1" parent="p0-pdpc">
          <mxGeometry x="20" y="884.0" width="760" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-11" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-api" target="p0-decide">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-12" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-decide" target="p0-engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-13" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-decide" target="p0-tstore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-14" value="Install" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#6c8ebf;fontColor=#1f3a5f;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.33;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-psrc" target="p0-engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-pepandpd-15" value="POST /v1/decide" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;horizontal=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-s5" target="p0-api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="875" y="822.9" />
              <mxPoint x="875" y="291.2" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p0-pepandpd-16" value="POST /v1/signals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;dashed=1;horizontal=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-s3" target="p0-api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="845" y="531.7" />
              <mxPoint x="845" y="228.8" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Request sequence" id="page-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1469" math="0" shadow="0" background="#FFFFFF">
      <root>
