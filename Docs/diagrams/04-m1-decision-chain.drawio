        <mxCell id="p1-requests-1" value="M1 — one request, step by step (hierarchical placement)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="13.0" width="1500" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="p1-dev" value="&lt;b&gt;PMU&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;edge&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
