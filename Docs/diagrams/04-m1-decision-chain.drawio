        <mxCell id="p1-ca" value="&lt;b&gt;ztc-ca&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;cloud&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="290.0" y="91.0" width="140" height="65.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-requests-3" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="p1-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="156.0" as="sourcePoint" />
            <mxPoint x="360" y="1300.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-pep" value="&lt;b&gt;ztc-pep&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;fog&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p1-1">
          <mxGeometry x="540.0" y="91.0" width="140" height="65.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-requests-4" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="p1-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="610" y="156.0" as="sourcePoint" />
            <mxPoint x="610" y="1300.0" as="targetPoint" />
