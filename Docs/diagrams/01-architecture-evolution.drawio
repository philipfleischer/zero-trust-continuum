        <mxCell id="p0-mileston-24" value="v0.5.0" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;align=right;fontSize=16;fontColor=#555555;" vertex="1" parent="p0-cardM5">
