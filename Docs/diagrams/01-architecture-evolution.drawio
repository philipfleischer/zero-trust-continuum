          <mxGeometry x="1280" y="130.0" width="400" height="390.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-15" value="M3 — Distributed systems" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;fontStyle=1;fontSize=19;align=left;spacingLeft=12;rounded=0;" vertex="1" parent="p0-cardM3">
          <mxGeometry x="0" y="0.0" width="400" height="52.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-16" value="v0.3.0" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;align=right;fontSize=16;fontColor=#555555;" vertex="1" parent="p0-cardM3">
          <mxGeometry x="320" y="10.4" width="70" height="31.2" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-17" value="&lt;b&gt;Adds&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:17px&quot;&gt;&lt;li&gt;Lamport, vector clocks, HLC on audit entries&lt;/li&gt;&lt;li&gt;Raft: 3 PDP replicas, leader failover ≈ 1 s&lt;/li&gt;&lt;li&gt;SWIM membership between fog nodes&lt;/li&gt;&lt;li&gt;Chord placement of device state&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;fontSize=17;" vertex="1" parent="p0-cardM3">
          <mxGeometry x="10" y="62.4" width="380" height="221.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-18" value="&lt;b&gt;Result: &lt;/b&gt;No single point of failure in the control plane; fog nodes find each other." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;fontSize=17;" vertex="1" parent="p0-cardM3">
