        <mxCell id="p0-mileston-8" value="v0.1.0" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;align=right;fontSize=16;fontColor=#555555;" vertex="1" parent="p0-cardM1">
          <mxGeometry x="320" y="10.4" width="70" height="31.2" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-9" value="&lt;b&gt;Adds&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:17px&quot;&gt;&lt;li&gt;ABAC policy engine: deny-overrides, default deny&lt;/li&gt;&lt;li&gt;continuous trust score&lt;/li&gt;&lt;li&gt;PDP + decision cache + placement (cloud / hierarchical / fog)&lt;/li&gt;&lt;li&gt;Ed25519 tokens, macaroon capabilities, revocation epoch&lt;/li&gt;&lt;li&gt;PEP gateway that fails closed&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;fontSize=17;" vertex="1" parent="p0-cardM1">
          <mxGeometry x="10" y="62.4" width="380" height="221.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-10" value="&lt;b&gt;Result: &lt;/b&gt;First end-to-end NIST 800-207 decision: 200 / 401 / 403." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;fontSize=17;" vertex="1" parent="p0-cardM1">
          <mxGeometry x="10" y="288.6" width="380" height="88.4" as="geometry" />
