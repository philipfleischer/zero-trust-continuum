        <mxCell id="p0-mileston-23" value="M5 — Industrial security" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;fontStyle=1;fontSize=19;align=left;spacingLeft=12;rounded=0;" vertex="1" parent="p0-cardM5">
