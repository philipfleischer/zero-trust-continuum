          <mxGeometry x="20" y="130.0" width="400" height="390.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-3" value="M0 — Foundation" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;fontStyle=1;fontSize=19;align=left;spacingLeft=12;rounded=0;" vertex="1" parent="p0-cardM0">
