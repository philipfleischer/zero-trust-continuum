        <mxCell id="p0-mileston-25" value="&lt;b&gt;Adds&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:17px&quot;&gt;&lt;li&gt;STRIDE threat model, MITRE ATT&amp;amp;CK for ICS&lt;/li&gt;&lt;li&gt;one zone model → NetworkPolicies + Cisco ACLs&lt;/li&gt;&lt;li&gt;Modbus/TCP + GOOSE codecs, ICS IDS rules&lt;/li&gt;&lt;li&gt;SPIFFE CA, mTLS everywhere, PEP obligations&lt;/li&gt;&lt;li&gt;CodeQL, govulncheck, gitleaks, Trivy&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;fontSize=17;" vertex="1" parent="p0-cardM5">
