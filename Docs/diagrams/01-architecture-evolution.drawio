          <mxGeometry x="440" y="130.0" width="400" height="390.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-7" value="M1 — Decision chain" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;fontStyle=1;fontSize=19;align=left;spacingLeft=12;rounded=0;" vertex="1" parent="p0-cardM1">
