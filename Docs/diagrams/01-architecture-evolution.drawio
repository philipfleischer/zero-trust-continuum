        <mxCell id="p0-mileston-1" value="Architecture evolution: M0 → M7 converge on the target architecture" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="13.0" width="1600" height="41.6" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-2" value="Built in vertical slices: every milestone ends with a working system (build, tests and the end-to-end demo stay green on main). New capabilities are switched on with ZTC_ environment variables, so earlier modes keep working." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=17;fontColor=#555555;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="57.2" width="1600" height="46.8" as="geometry" />
        </mxCell>
