        </mxCell>
        <mxCell id="p0-mileston-26" value="&lt;b&gt;Result: &lt;/b&gt;Hardened towards IEC 62443 SL-T 3; every threat maps to a control in code." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;fontSize=17;" vertex="1" parent="p0-cardM5">
