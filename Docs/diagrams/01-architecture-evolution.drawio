        </mxCell>
        <mxCell id="p0-mileston-4" value="v0.0.1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;align=right;fontSize=16;fontColor=#555555;" vertex="1" parent="p0-cardM0">
          <mxGeometry x="320" y="10.4" width="70" height="31.2" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-5" value="&lt;b&gt;Adds&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:17px&quot;&gt;&lt;li&gt;Go module, standard library only&lt;/li&gt;&lt;li&gt;shared service shell: ZTC_ config, JSON logs, Prometheus metrics, /healthz /readyz /metrics, graceful shutdown&lt;/li&gt;&lt;li&gt;Makefile, CI: race tests, golangci-lint (gosec), actionlint, Dependabot&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;fontSize=17;" vertex="1" parent="p0-cardM0">
          <mxGeometry x="10" y="62.4" width="380" height="221.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-6" value="&lt;b&gt;Result: &lt;/b&gt;One observable, empty service. Every later service starts from the same shell." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;fontSize=17;" vertex="1" parent="p0-cardM0">
          <mxGeometry x="10" y="288.6" width="380" height="88.4" as="geometry" />
