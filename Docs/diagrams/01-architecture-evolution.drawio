        <mxCell id="p0-mileston-20" value="v0.4.0" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;align=right;fontSize=16;fontColor=#555555;" vertex="1" parent="p0-cardM4">
          <mxGeometry x="320" y="10.4" width="70" height="31.2" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-21" value="&lt;b&gt;Adds&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:17px&quot;&gt;&lt;li&gt;trust-aware offloading, 5 load balancers&lt;/li&gt;&lt;li&gt;distroless multi-arch images, SBOM&lt;/li&gt;&lt;li&gt;Compose: one network per IEC 62443 zone&lt;/li&gt;&lt;li&gt;Prometheus + Grafana, alert rules&lt;/li&gt;&lt;li&gt;Kubernetes: default-deny NetworkPolicies, StatefulSet PDP, Helm&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;fontSize=17;" vertex="1" parent="p0-cardM4">
          <mxGeometry x="10" y="62.4" width="380" height="221.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-22" value="&lt;b&gt;Result: &lt;/b&gt;The system runs as a segmented, observable, orchestrated deployment." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;fontSize=17;" vertex="1" parent="p0-cardM4">
