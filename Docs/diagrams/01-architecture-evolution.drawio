          <mxGeometry x="20" y="572.0" width="400" height="390.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-19" value="M4 — Offloading and containers" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;fontStyle=1;fontSize=19;align=left;spacingLeft=12;rounded=0;" vertex="1" parent="p0-cardM4">
