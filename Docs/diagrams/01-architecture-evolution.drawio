          <mxGeometry x="860" y="130.0" width="400" height="390.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-11" value="M2 — Fog, IDS and demo" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=16;fontColor=#222222;spacing=4;fontStyle=1;fontSize=19;align=left;spacingLeft=12;rounded=0;" vertex="1" parent="p0-cardM2">
          <mxGeometry x="0" y="0.0" width="400" height="52.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-12" value="v0.2.0" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;align=right;fontSize=16;fontColor=#555555;" vertex="1" parent="p0-cardM2">
          <mxGeometry x="320" y="10.4" width="70" height="31.2" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-13" value="&lt;b&gt;Adds&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:17px&quot;&gt;&lt;li&gt;telemetry pipeline + ztc-ingest&lt;/li&gt;&lt;li&gt;ztc-edge devices and attacks (FDI, replay, flood)&lt;/li&gt;&lt;li&gt;ztc-fog aggregation 50 Hz → 1 Hz&lt;/li&gt;&lt;li&gt;IDS → trust signal → compromise → cache flush&lt;/li&gt;&lt;li&gt;hash-chained audit log, e2e demo in CI&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=16;fontColor=#222222;fontSize=17;" vertex="1" parent="p0-cardM2">
          <mxGeometry x="10" y="62.4" width="380" height="221.0" as="geometry" />
        </mxCell>
        <mxCell id="p0-mileston-14" value="&lt;b&gt;Result: &lt;/b&gt;Continuous verification loop: a compromised PMU is locked out, honest devices keep working." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=15;fontColor=#333333;fontSize=17;" vertex="1" parent="p0-cardM2">
