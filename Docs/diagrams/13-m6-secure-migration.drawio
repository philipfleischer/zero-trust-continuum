              <mxPoint x="860" y="388" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p0-handover-13" value="short-lived credentials for the service" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;dashed=1;endArrow=open;endFill=0;verticalAlign=bottom;" edge="1" parent="p0-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="430" as="sourcePoint" />
            <mxPoint x="490" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p0-handover-14" value="Seal(state) for fog-B: X25519 + HKDF-SHA256 + AES-256-GCM" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;verticalAlign=bottom;" edge="1" parent="p0-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="480" as="sourcePoint" />
            <mxPoint x="490" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p0-handover-15" value="Open, restore, start" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;align=left;spacingLeft=46;labelBackgroundColor=none;" edge="1" parent="p0-1">
          <mxGeometry relative="1" as="geometry">
