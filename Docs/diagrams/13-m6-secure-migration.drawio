        </mxCell>
        <mxCell id="p0-handover-10" value="HandoverTicket{service, to = fog-B, targetKey, nonce, exp = 10 s, HLC} signed by fog-A" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;verticalAlign=bottom;" edge="1" parent="p0-1">
