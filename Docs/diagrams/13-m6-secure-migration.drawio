        </mxCell>
        <mxCell id="p0-handover-9" value="freeze the service, snapshot state" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;align=left;spacingLeft=46;labelBackgroundColor=none;" edge="1" parent="p0-1">
