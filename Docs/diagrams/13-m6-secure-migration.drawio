        <mxCell id="p0-handover-2" value="A service moves from one fog node to another. Its state must not leak, its credentials must not be usable by anyone but the target, and it should keep working when the substation is cut off from the cloud." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="p0-1">
