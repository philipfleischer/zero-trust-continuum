        <mxCell id="p0-handover-18" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=mxgraph.basic.x;fillColor=#b85450;strokeColor=none;" vertex="1" parent="p0-1">
          <mxGeometry x="1137" y="330" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p0-handover-19" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;WAN partition after the decision&lt;/b&gt;&lt;br&gt;the rest of the migration needs no cloud&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;fontColor=#b85450;" vertex="1" parent="p0-1">
          <mxGeometry x="1170" y="320" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p0-handover-20" value="&lt;b&gt;Why the authority sits on the fog&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;if the cloud validates the ticket, migration fails whenever the WAN is down — exactly when local autonomy matters&lt;/li&gt;&lt;li&gt;the target knows the source fog node's public key (from the CA bundle), so it can validate locally&lt;/li&gt;&lt;li&gt;the PDP is still asked for the migrate decision beforehand; during a partition a fog PDP replica answers&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p0-1">
          <mxGeometry x="40" y="680" width="900" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p0-handover-21" value="&lt;b&gt;Ticket properties&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;signed by the source: authenticity&lt;/li&gt;&lt;li&gt;bound to the target's key: useless to anyone else&lt;/li&gt;&lt;li&gt;single-use nonce + 10 s expiry: no replay&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p0-1">
          <mxGeometry x="980" y="680" width="540" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
