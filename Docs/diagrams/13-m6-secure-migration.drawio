        <mxCell id="p0-handover-1" value="M6 — secure service migration with a handover ticket (RQ3)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="p0-1">
