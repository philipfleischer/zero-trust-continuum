          </mxGeometry>
        </mxCell>
        <mxCell id="p1-migratio-22" value="&lt;b&gt;Expected outcome (hypothesis)&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Strategy&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Downtime&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Exposure window&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;background:#e8e8e8;padding:3px 5px;text-align:left;&quot;&gt;Under WAN partition&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;full re-auth (cloud)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;high, grows with WAN delay&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;minimal&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;fails&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;pre-auth&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;lowest&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;long (lead time)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;works if done before the cut&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;token handover, cloud validates&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;like full re-auth&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;short&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;fails&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;token handover, fog validates&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;close to pre-auth&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;short (ticket TTL)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 5px;vertical-align:top;background:#ffffff;&quot;&gt;works&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=11;overflow=fill;fontColor=#222222;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="620" width="900" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p1-migratio-23" value="&lt;b&gt;Sealing the state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px&quot;&gt;eph = X25519 keypair (per migration)&lt;br&gt;shared = X25519(eph.priv, target.pub)&lt;br&gt;key = HKDF-SHA256(shared, salt, &quot;ztc-migration v1&quot; ‖ service)&lt;br&gt;ct = AES-256-GCM(key, nonce, state, aad = ticket id)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;only the target can open it; the ticket id as AAD binds the state to this migration; RFC 5869 test vector in the tests&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p1-1">
          <mxGeometry x="1000" y="130" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p1-migratio-24" value="&lt;b&gt;Failure handling (IN5020: distributed transactions)&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:11px&quot;&gt;&lt;li&gt;source crashes after sending the ticket: ticket expires in 10 s; target never starts without the sealed state&lt;/li&gt;&lt;li&gt;target crashes after restore: source keeps the frozen snapshot until it receives ready&lt;/li&gt;&lt;li&gt;duplicate delivery: nonce is single-use, restore is idempotent&lt;/li&gt;&lt;li&gt;net effect: at most one running copy — never two&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="1000" y="360" width="700" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-migratio-25" value="&lt;b&gt;Implemented twice&lt;/b&gt;: services/internal/migration (Go, ztc-migrate experiment CLI → CSV) and the OMNeT++ MigrationController, so simulated and measured downtime can be compared." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="1000" y="520" width="700" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>