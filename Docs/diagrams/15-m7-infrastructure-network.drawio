  <diagram name="Infrastructure as code" id="page-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="630" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p1-0" />
        <mxCell id="p1-1" parent="p1-0" />
        <mxCell id="p1-infrastr-1" value="M7 — from nothing to a running continuum: Terraform → Ansible → Kubernetes" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="10.5" width="1600" height="33.6" as="geometry" />
        </mxCell>
        <mxCell id="p1-infrastr-2" value="Every environment is reproducible from the repository. The zone model appears a fourth time, as OpenStack security groups." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=20;fontColor=#555555;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="46.2" width="1600" height="35.7" as="geometry" />
        </mxCell>
        <mxCell id="p1-tf" value="&lt;b&gt;Terraform (NREC / OpenStack)&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:18px&quot;&gt;&lt;li&gt;provider and versions pinned&lt;/li&gt;&lt;li&gt;one network + security group per zone&lt;/li&gt;&lt;li&gt;cloud VMs and fog VMs with cloud-init&lt;/li&gt;&lt;li&gt;outputs → Ansible inventory (inventory.tftpl)&lt;/li&gt;&lt;li&gt;CI: terraform fmt -check, validate&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=19;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="115.5" width="390" height="173.2" as="geometry" />
        </mxCell>
        <mxCell id="p1-ans" value="&lt;b&gt;Ansible&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:18px&quot;&gt;&lt;li&gt;common: packages, chrony time sync&lt;/li&gt;&lt;li&gt;hardening (CIS-style): SSH, sysctl, auditd&lt;/li&gt;&lt;li&gt;k3s server and agents; fog nodes tainted&lt;/li&gt;&lt;li&gt;site playbook; ansible-lint in CI&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=19;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p1-1">
          <mxGeometry x="440" y="115.5" width="390" height="173.2" as="geometry" />
        </mxCell>
        <mxCell id="p1-infrastr-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=18;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p1-1" source="p1-tf" target="p1-ans">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-k8s" value="&lt;b&gt;Kubernetes deploy&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:18px&quot;&gt;&lt;li&gt;kubectl apply -k overlays/edge or Helm&lt;/li&gt;&lt;li&gt;arm64 images for Raspberry Pi fog nodes&lt;/li&gt;&lt;li&gt;generated NetworkPolicies&lt;/li&gt;&lt;li&gt;Prometheus + Grafana&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=19;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p1-1">
          <mxGeometry x="860" y="115.5" width="390" height="173.2" as="geometry" />
        </mxCell>
        <mxCell id="p1-infrastr-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=18;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p1-1" source="p1-ans" target="p1-k8s">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-run" value="&lt;b&gt;Running continuum&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:18px&quot;&gt;&lt;li&gt;3 PDP replicas in the cloud&lt;/li&gt;&lt;li&gt;PEP + fog + IDS on each fog node&lt;/li&gt;&lt;li&gt;simulated devices at the edge&lt;/li&gt;&lt;li&gt;demo and failure drills against real hardware&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=19;fontColor=#222222;spacing=4;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p1-1">
          <mxGeometry x="1280" y="115.5" width="390" height="173.2" as="geometry" />
        </mxCell>
        <mxCell id="p1-infrastr-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=18;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;" edge="1" parent="p1-1" source="p1-k8s" target="p1-run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-infrastr-6" value="&lt;b&gt;Free lab of the same network: containerlab&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:18px&quot;&gt;&lt;li&gt;FRR routers and Linux hosts with nftables as the zone firewall&lt;/li&gt;&lt;li&gt;reachability matrix script: every allowed conduit answers, every other pair times out&lt;/li&gt;&lt;li&gt;runs on a laptop, no Cisco licence needed&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=18;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="320.2" width="820" height="126.0" as="geometry" />
        </mxCell>
        <mxCell id="p1-infrastr-7" value="&lt;b&gt;Why this toolchain&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:18px&quot;&gt;&lt;li&gt;Terraform: declarative, plan before apply, state shows drift&lt;/li&gt;&lt;li&gt;Ansible: agentless over SSH, fits small fog fleets and Raspberry Pis&lt;/li&gt;&lt;li&gt;k3s: a certified Kubernetes in one binary, sized for fog hardware&lt;/li&gt;&lt;li&gt;the same manifests run on kind (laptop) and k3s (fog) via kustomize overlays&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=18;fontColor=#333333;" vertex="1" parent="p1-1">
          <mxGeometry x="880" y="320.2" width="820" height="157.5" as="geometry" />
        </mxCell>
        <mxCell id="p1-infrastr-8" value="&lt;b&gt;Security notes&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:18px&quot;&gt;&lt;li&gt;secrets never in Terraform state or the repo: OpenStack credentials from the environment&lt;/li&gt;&lt;li&gt;SSH keys only, password login disabled by the hardening role&lt;/li&gt;&lt;li&gt;time sync is a security control here: short-lived certificates fail on clock skew&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=19;fontColor=#222222;spacing=4;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="472.5" width="820" height="126.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>