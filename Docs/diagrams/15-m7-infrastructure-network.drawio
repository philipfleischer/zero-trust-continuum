        <mxCell id="p0-networkd-1" value="M7 — Purdue-segmented substation network in Cisco IOS" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="p0-1">
