        <mxCell id="p0-systemov-59" value="&lt;b&gt;Secure supply chain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Go standard library only, race tests, golangci-lint, CodeQL, govulncheck, gosec, gitleaks, Trivy, SBOM, distroless non-root multi-arch images&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=12;fontColor=#222222;spacing=4;" vertex="1" parent="p0-1">
