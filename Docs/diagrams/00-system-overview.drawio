        <mxCell id="p0-txt-66" value="trust signal" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1274" y="573" width="86.4544" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p0-ln-67" style="edgeStyle=none;html=1;rounded=0;strokeColor=#82b366;strokeWidth=3.5;endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;exitX=0.6400;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8302;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="900" as="sourcePoint" /><mxPoint x="1640" y="740" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p0-ln-68" style="edgeStyle=none;html=1;rounded=0;strokeColor=#82b366;strokeWidth=3.5;endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;exitX=0.6792;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5143;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="640" as="sourcePoint" /><mxPoint x="1560" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p0-txt-69" value="telemetry" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#2d4d1f;" vertex="1" parent="1"><mxGeometry x="1551.57632" y="828" width="74.42368" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p0-txt-70" value="telemetry" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#2d4d1f;" vertex="1" parent="1"><mxGeometry x="1471.57632" y="573" width="74.42368" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p0-txt-71" value="&lt;b&gt;The cycle&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=22;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="40" y="1670" width="1000" height="33.040000000000006" as="geometry" /></mxCell>
        <mxCell id="p0-step-72" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1716" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p0-txt-73" value="&lt;b&gt;Enrol&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="82" y="1721" width="200" height="27.76" as="geometry" /></mxCell>
        <mxCell id="p0-step-74" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="215" y="1716" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p0-txt-75" value="&lt;b&gt;Request&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="257" y="1721" width="200" height="27.76" as="geometry" /></mxCell>
        <mxCell id="p0-step-76" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="390" y="1716" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p0-txt-77" value="&lt;b&gt;Decide&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="432" y="1721" width="200" height="27.76" as="geometry" /></mxCell>
        <mxCell id="p0-step-78" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="565" y="1716" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p0-txt-79" value="&lt;b&gt;Enforce&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="607" y="1721" width="200" height="27.76" as="geometry" /></mxCell>
        <mxCell id="p0-step-80" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="1716" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p0-txt-81" value="&lt;b&gt;Watch&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="782" y="1721" width="200" height="27.76" as="geometry" /></mxCell>
        <mxCell id="p0-step-82" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4a6fa5;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="915" y="1716" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p0-txt-83" value="&lt;b&gt;Revoke&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="957" y="1721" width="200" height="27.76" as="geometry" /></mxCell>
        <mxCell id="p0-box-84" value="&lt;b&gt;Never trust the location&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Being on the substation network grants nothing. Every device and&lt;br&gt;service proves who it is.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="40.0" y="1780" width="553.3333333333334" height="110" as="geometry" /></mxCell>
        <mxCell id="p0-box-85" value="&lt;b&gt;Verify every request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Each request is judged by policy and a live trust score, then enforced&lt;br&gt;at the gatekeeper.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="623.3333333333334" y="1780" width="553.3333333333334" height="110" as="geometry" /></mxCell>
        <mxCell id="p0-box-86" value="&lt;b&gt;Keep checking&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Behaviour keeps feeding the trust score, and a device that turns&lt;br&gt;suspicious is locked out.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1206.6666666666667" y="1780" width="553.3333333333334" height="110" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Target architecture" id="p1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2580" pageHeight="3633" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-txt-1" value="&lt;b&gt;ZTC: Zero-Trust Continuum, target architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=32;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="2400" height="46.24" as="geometry" /></mxCell>
        <mxCell id="p1-txt-2" value="Zero trust (NIST SP 800-207) for a digital power substation, from the field devices to the control centre. Being on the network grants nothing: every request carries a verifiable identity, is judged by policy and a live trust score, and is enforced before it&lt;br&gt;reaches anything that matters. Follow the numbered steps 1 to 6 for one full cycle." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=20;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2300" height="56.800000000000004" as="geometry" /></mxCell>
        <mxCell id="p1-cloud-3" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;container=1;collapsible=0;recursiveResize=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="2500" height="530" as="geometry" /></mxCell>
        <mxCell id="p1-hdr-4" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot;&gt;CLOUD&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Control centre&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#555555&quot;&gt;Purdue L4-5 · IEC 62443 SL-T 3&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;Issues identities, decides on every&lt;br&gt;request, keeps the trust scores&lt;br&gt;and the records.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#1f3a5f;spacing=0;" vertex="1" parent="p1-cloud-3"><mxGeometry x="24" y="22" width="270" height="260" as="geometry" /></mxCell>
        <mxCell id="p1-box-5" value="&lt;b&gt;Security operators&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Write policy as code and&lt;br&gt;review it like software.&lt;br&gt;Changing it needs the admin&lt;br&gt;role and high trust.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="270" width="260" height="150" as="geometry" /></mxCell>
        <mxCell id="p1-box-6" value="&lt;b&gt;Identity provider&lt;br&gt;(ztc-ca)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Gives every device and&lt;br&gt;service a short-lived certificate&lt;br&gt;with its own identity, and can&lt;br&gt;revoke it.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="260" height="160" as="geometry" /></mxCell>
        <mxCell id="p1-grp-7" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;container=1;collapsible=0;recursiveResize=0;fillColor=#ffffff;strokeColor=#888888;dashed=1;strokeWidth=1.5;html=1;" vertex="1" parent="1"><mxGeometry x="800" y="240" width="1040" height="425" as="geometry" /></mxCell>
        <mxCell id="p1-txt-8" value="&lt;b&gt;Policy Decision Point (ztc-pdp): three replicas kept in sync&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#333333;" vertex="1" parent="p1-grp-7"><mxGeometry x="18" y="12" width="1004" height="27.76" as="geometry" /></mxCell>
        <mxCell id="p1-txt-9" value="&lt;b&gt;TB4 replica ↔ replica&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#b85450;" vertex="1" parent="p1-grp-7"><mxGeometry x="850.11904" y="14" width="171.88096000000002" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-box-10" value="&lt;b&gt;ztc-pdp-0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;leader&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="870" y="300" width="230" height="76" as="geometry" /></mxCell>
        <mxCell id="p1-box-11" value="&lt;b&gt;ztc-pdp-1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;follower&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1205" y="300" width="230" height="76" as="geometry" /></mxCell>
        <mxCell id="p1-box-12" value="&lt;b&gt;ztc-pdp-2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;follower&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1540" y="300" width="230" height="76" as="geometry" /></mxCell>
        <mxCell id="p1-ln-13" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;endSize=7;startArrow=block;startFill=1;startSize=7;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="338.0" as="sourcePoint" /><mxPoint x="1205" y="338.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-14" value="Raft" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1134.24112" y="308.0" width="36.51776" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-ln-15" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;endSize=7;startArrow=block;startFill=1;startSize=7;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1435" y="338.0" as="sourcePoint" /><mxPoint x="1540" y="338.0" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-16" value="Raft" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1469.24112" y="308.0" width="36.51776" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-txt-17" value="&lt;i&gt;Inside every replica:&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="825" y="404" width="600" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-box-18" value="&lt;b&gt;Policy Administrator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Manages policy versions&lt;br&gt;and announces&lt;br&gt;revocations to every PEP.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="825" y="440" width="230" height="190" as="geometry" /></mxCell>
        <mxCell id="p1-box-19" value="&lt;b&gt;Policy Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Judges each request&lt;br&gt;against the policy rules&lt;br&gt;and the current trust&lt;br&gt;score. Denies by default.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1077" y="440" width="230" height="190" as="geometry" /></mxCell>
        <mxCell id="p1-box-20" value="&lt;b&gt;Trust store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;A live trust score for every&lt;br&gt;device, lowered by trust&lt;br&gt;signals.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;" vertex="1" parent="1"><mxGeometry x="1329" y="440" width="230" height="190" as="geometry" /></mxCell>
        <mxCell id="p1-box-21" value="&lt;b&gt;Raft log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Every policy version and&lt;br&gt;revocation, the same on all&lt;br&gt;replicas.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;" vertex="1" parent="1"><mxGeometry x="1581" y="440" width="234" height="190" as="geometry" /></mxCell>
        <mxCell id="p1-box-22" value="&lt;b&gt;Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Prometheus and Grafana&lt;br&gt;collect health and metrics&lt;br&gt;from every service and&lt;br&gt;raise alerts.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1960" y="270" width="240" height="150" as="geometry" /></mxCell>
        <mxCell id="p1-box-23" value="&lt;b&gt;Audit log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Tamper-evident record of&lt;br&gt;every decision and policy&lt;br&gt;change.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;" vertex="1" parent="1"><mxGeometry x="1960" y="480" width="240" height="160" as="geometry" /></mxCell>
        <mxCell id="p1-ln-24" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;exitX=1.0000;exitY=0.7529;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1840" y="560" as="sourcePoint" /><mxPoint x="1960" y="560" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-25" value="every&lt;br&gt;decision" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1868.3896" y="512" width="63.220800000000004" height="43.6" as="geometry" /></mxCell>
        <mxCell id="p1-grp-26" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;container=1;collapsible=0;recursiveResize=0;fillColor=#ffffff;strokeColor=#888888;dashed=1;strokeWidth=1.5;html=1;" vertex="1" parent="1"><mxGeometry x="2260" y="240" width="260" height="190" as="geometry" /></mxCell>
        <mxCell id="p1-txt-27" value="&lt;b&gt;Enterprise IT (L5)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#333333;" vertex="1" parent="p1-grp-26"><mxGeometry x="18" y="12" width="224" height="27.76" as="geometry" /></mxCell>
        <mxCell id="p1-box-28" value="&lt;b&gt;Analytics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Finds anomalies and&lt;br&gt;builds the evaluation&lt;br&gt;figures.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="2280" y="290" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="p1-box-29" value="&lt;b&gt;Telemetry store&lt;br&gt;(ztc-ingest)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Keeps the per-second&lt;br&gt;measurements from the&lt;br&gt;substation.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="2260" y="480" width="260" height="160" as="geometry" /></mxCell>
        <mxCell id="p1-ln-30" style="edgeStyle=none;html=1;rounded=0;strokeColor=#82b366;strokeWidth=3.5;endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2390" y="480" as="sourcePoint" /><mxPoint x="2390" y="410" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-31" value="read-only" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=15;fontColor=#2d4d1f;" vertex="1" parent="1"><mxGeometry x="2402" y="440" width="71.02080000000001" height="23.8" as="geometry" /></mxCell>
        <mxCell id="p1-ln-32" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;exitX=1.0000;exitY=0.4000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.2118;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="330" as="sourcePoint" /><mxPoint x="800" y="330" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-33" value="policy&lt;br&gt;changes" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="697.516" y="282" width="64.968" height="43.6" as="geometry" /></mxCell>
        <mxCell id="p1-txt-34" value="&lt;b&gt;TB6&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=15;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="712.2658" y="340" width="35.4684" height="23.8" as="geometry" /></mxCell>
        <mxCell id="p1-ln-35" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b85450;strokeWidth=2.5;dashed=1;dashPattern=12 7;endArrow=none;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="740" as="sourcePoint" /><mxPoint x="2540" y="740" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-36" value="&lt;b&gt;TB3 substation ↔ control centre, across the WAN&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1500" y="708" width="423.05352" height="26.44" as="geometry" /></mxCell>
        <mxCell id="p1-dmz-37" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;container=1;collapsible=0;recursiveResize=0;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="2500" height="270" as="geometry" /></mxCell>
        <mxCell id="p1-hdr-38" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot;&gt;OT-DMZ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Buffer zone and WAN&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#555555&quot;&gt;Purdue L3.5 · IEC 62443 SL-T 2&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;Nothing goes straight between&lt;br&gt;substation and control centre. The&lt;br&gt;WAN can be slow or cut off.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#4b2a5c;spacing=0;" vertex="1" parent="p1-dmz-37"><mxGeometry x="24" y="22" width="270" height="260" as="geometry" /></mxCell>
        <mxCell id="p1-box-39" value="&lt;b&gt;Substation firewall (SUB1-FW)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Zone-based firewall with an encrypted IPsec tunnel over the WAN (fibre, MPLS or 4G/5G). Carries enrolment, decisions and&lt;br&gt;revocations.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="910" width="960" height="120" as="geometry" /></mxCell>
        <mxCell id="p1-box-40" value="&lt;b&gt;Message broker (MQTT over TLS)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Carries telemetry and trust signals up to the control centre.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1400" y="910" width="1120" height="120" as="geometry" /></mxCell>
        <mxCell id="p1-fog-41" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;container=1;collapsible=0;recursiveResize=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="2500" height="660" as="geometry" /></mxCell>
        <mxCell id="p1-hdr-42" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot;&gt;FOG&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Substation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#555555&quot;&gt;Purdue L3 · IEC 62443 SL-T 3&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;Enforces every request close to&lt;br&gt;the devices and keeps working&lt;br&gt;when the WAN is down.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#2d4d1f;spacing=0;" vertex="1" parent="p1-fog-41"><mxGeometry x="24" y="22" width="270" height="260" as="geometry" /></mxCell>
        <mxCell id="p1-box-43" value="&lt;b&gt;Intrusion detection (ztc-ids)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Checks field traffic for known attacks on&lt;br&gt;industrial protocols (MITRE ATT&amp;amp;CK for ICS)&lt;br&gt;and scores unusual behaviour.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1400" y="1250" width="380" height="170" as="geometry" /></mxCell>
        <mxCell id="p1-box-44" value="&lt;b&gt;Fog node (ztc-fog)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Does the substation's work: checks and summarises&lt;br&gt;telemetry, runs offloaded tasks and moves services&lt;br&gt;between fog nodes.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1980" y="1250" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="p1-box-45" value="&lt;b&gt;Decision cache or local&lt;br&gt;PDP replica&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Recent answers, so the PEP can&lt;br&gt;still decide when the WAN is&lt;br&gt;down. They expire, and a&lt;br&gt;revocation clears them.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="1540" width="290" height="180" as="geometry" /></mxCell>
        <mxCell id="p1-box-46" value="&lt;b&gt;Policy Enforcement Point (ztc-pep)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;The gatekeeper. Checks the certificate on&lt;br&gt;every request, gets a decision and lets only&lt;br&gt;allowed requests through.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="1540" width="380" height="180" as="geometry" /></mxCell>
        <mxCell id="p1-box-47" value="&lt;b&gt;Other fog nodes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Take over work and receive services that&lt;br&gt;migrate. Membership is tracked by gossip.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="2150" y="1560" width="350" height="150" as="geometry" /></mxCell>
        <mxCell id="p1-ln-48" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;endSize=7;startArrow=block;startFill=1;startSize=7;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="1630" as="sourcePoint" /><mxPoint x="890" y="1630" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-49" value="cached?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="917.516" y="1596" width="64.968" height="23.8" as="geometry" /></mxCell>
        <mxCell id="p1-ln-50" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;exitX=1.0000;exitY=0.5556;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1429;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1390" y="1640" as="sourcePoint" /><mxPoint x="2040" y="1420" as="targetPoint" /><Array as="points"><mxPoint x="2040" y="1640" /></Array></mxGeometry></mxCell>
        <mxCell id="p1-ln-51" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b85450;strokeWidth=2.5;dashed=1;dashPattern=12 7;endArrow=none;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="1520" as="sourcePoint" /><mxPoint x="1500" y="1760" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-52" value="&lt;b&gt;TB2&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1481.28352" y="1494" width="37.43296" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-step-53" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1544" y="1596" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p1-txt-54" value="allowed requests only" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1584" y="1600" width="165.99360000000001" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-ln-55" style="edgeStyle=none;html=1;rounded=0;strokeColor=#888888;strokeWidth=2;dashed=1;dashPattern=3 4;endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1980" y="1335" as="sourcePoint" /><mxPoint x="1780" y="1335" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-56" value="traffic copy" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=15;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1839.287" y="1302" width="81.426" height="23.8" as="geometry" /></mxCell>
        <mxCell id="p1-ln-57" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;endSize=7;startArrow=block;startFill=1;startSize=7;exitX=0.8095;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4857;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2320" y="1420" as="sourcePoint" /><mxPoint x="2320" y="1560" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-58" value="offload, gossip,&lt;br&gt;migration" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=15;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2334" y="1460" width="110.9256" height="43.6" as="geometry" /></mxCell>
        <mxCell id="p1-txt-59" value="&lt;b&gt;TB5&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="2268.56704" y="1478" width="37.43296" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-ln-60" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b85450;strokeWidth=2.5;dashed=1;dashPattern=12 7;endArrow=none;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1815" as="sourcePoint" /><mxPoint x="2540" y="1815" as="targetPoint" /></mxGeometry></mxCell>
