        <mxCell id="p0-txt-21" value="allowed only" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1274" y="1095" width="97.55328" height="25.12" as="geometry" /></mxCell>
