        <mxCell id="p1-txt-112" value="&lt;b&gt;One full cycle, in six steps&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="40" y="2360" width="1400" height="35.68" as="geometry" /></mxCell>
        <mxCell id="p1-step-113" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="2410" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p1-txt-114" value="&lt;b&gt;Enrol&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=19;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="86" y="2414" width="600" height="29.080000000000002" as="geometry" /></mxCell>
        <mxCell id="p1-txt-115" value="A device proves that it may join with a one-time join token, and gets a short-lived certificate with its own identity from the identity provider. Like everything that leaves the&lt;br&gt;substation, the request passes the firewall." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="86" y="2442" width="1440" height="51.52" as="geometry" /></mxCell>
        <mxCell id="p1-step-116" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="2511.52" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p1-txt-117" value="&lt;b&gt;Request&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=19;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="86" y="2515.52" width="600" height="29.080000000000002" as="geometry" /></mxCell>
        <mxCell id="p1-txt-118" value="Every request the device sends carries that certificate. It goes over the field network to the Policy Enforcement Point (PEP), which checks it with mutual TLS." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="86" y="2543.52" width="1440" height="27.76" as="geometry" /></mxCell>
        <mxCell id="p1-step-119" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="2589.28" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p1-txt-120" value="&lt;b&gt;Decide&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=19;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="86" y="2593.28" width="600" height="29.080000000000002" as="geometry" /></mxCell>
        <mxCell id="p1-txt-121" value="The PEP first looks for a recent answer in its decision cache. If there is none, it asks the Policy Engine in the control centre through the firewall. The answer combines the&lt;br&gt;policy with the device's current trust score, and the audit log records it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="86" y="2621.28" width="1440" height="51.52" as="geometry" /></mxCell>
        <mxCell id="p1-step-122" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="2690.8" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p1-txt-123" value="&lt;b&gt;Enforce&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=19;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="86" y="2694.8" width="600" height="29.080000000000002" as="geometry" /></mxCell>
        <mxCell id="p1-txt-124" value="Only allowed requests are passed on to the fog node. A denied request stops at the PEP." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="86" y="2722.8" width="1440" height="27.76" as="geometry" /></mxCell>
        <mxCell id="p1-step-125" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="2768.5600000000004" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p1-txt-126" value="&lt;b&gt;Watch&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=19;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="86" y="2772.5600000000004" width="600" height="29.080000000000002" as="geometry" /></mxCell>
        <mxCell id="p1-txt-127" value="The intrusion detection system gets a copy of the field traffic from the fog node. When a device behaves suspiciously, it sends a trust signal through the broker, and the&lt;br&gt;device's trust score drops." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="86" y="2800.5600000000004" width="1440" height="51.52" as="geometry" /></mxCell>
        <mxCell id="p1-step-128" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4a6fa5;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="2870.0800000000004" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p1-txt-129" value="&lt;b&gt;Revoke&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=19;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="86" y="2874.0800000000004" width="600" height="29.080000000000002" as="geometry" /></mxCell>
        <mxCell id="p1-txt-130" value="The Policy Administrator announces a new revocation epoch through the firewall. Every PEP clears its cached answers, so the device's next request is decided again with the&lt;br&gt;lower score, and denied." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="86" y="2902.0800000000004" width="1440" height="51.52" as="geometry" /></mxCell>
        <mxCell id="p1-txt-131" value="&lt;b&gt;How to read it&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1620" y="2360" width="920" height="35.68" as="geometry" /></mxCell>
        <mxCell id="p1-box-132" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1620" y="2412" width="40" height="22" as="geometry" /></mxCell>
        <mxCell id="p1-txt-133" value="Cloud: control centre (Purdue L4-5)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1672" y="2412" width="400" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-box-134" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="2080" y="2412" width="40" height="22" as="geometry" /></mxCell>
        <mxCell id="p1-txt-135" value="OT-DMZ and WAN (Purdue L3.5)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2132" y="2412" width="400" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-box-136" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1620" y="2446" width="40" height="22" as="geometry" /></mxCell>
        <mxCell id="p1-txt-137" value="Fog: substation (Purdue L3)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1672" y="2446" width="400" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-box-138" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="2080" y="2446" width="40" height="22" as="geometry" /></mxCell>
        <mxCell id="p1-txt-139" value="Edge: field devices (Purdue L0-2)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2132" y="2446" width="400" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-box-140" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1620" y="2480" width="40" height="22" as="geometry" /></mxCell>
        <mxCell id="p1-txt-141" value="Threat" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1672" y="2480" width="400" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-ln-142" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1620" y="2539" as="sourcePoint" /><mxPoint x="1664" y="2539" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-143" value="request or data path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1676" y="2528" width="390" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-ln-144" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=8 5;endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="2539" as="sourcePoint" /><mxPoint x="2124" y="2539" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-145" value="trust signal (continuous verification)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2136" y="2528" width="390" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-ln-146" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=8 5;endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1620" y="2573" as="sourcePoint" /><mxPoint x="1664" y="2573" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-147" value="control: revocation" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1676" y="2562" width="390" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-ln-148" style="edgeStyle=none;html=1;rounded=0;strokeColor=#82b366;strokeWidth=3.5;endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="2573" as="sourcePoint" /><mxPoint x="2124" y="2573" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-149" value="telemetry" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2136" y="2562" width="390" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-ln-150" style="edgeStyle=none;html=1;rounded=0;strokeColor=#888888;strokeWidth=2;dashed=1;dashPattern=3 4;endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1620" y="2607" as="sourcePoint" /><mxPoint x="1664" y="2607" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-151" value="copy of traffic for inspection" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1676" y="2596" width="390" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-ln-152" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b85450;strokeWidth=2.5;dashed=1;dashPattern=12 7;endArrow=none;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="2607" as="sourcePoint" /><mxPoint x="2124" y="2607" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1-txt-153" value="trust boundary TB1-TB6" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2136" y="2596" width="390" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-step-154" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1620" y="2640" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="p1-txt-155" value="a step of the cycle, shown on every part of its path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1666" y="2644" width="870" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-txt-156" value="An arrow that ends at the firewall or the broker carries on out of the other side, with the same number and style. Nothing&lt;br&gt;crosses the DMZ any other way." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1620" y="2682" width="920" height="46.24" as="geometry" /></mxCell>
        <mxCell id="p1-txt-157" value="Monitoring reads metrics from every service. Those lines are left out to keep the picture readable." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1620" y="2736.24" width="920" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-txt-158" value="SL-T is the IEC 62443 security level target of a zone." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1620" y="2769.3599999999997" width="920" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p1-note-159" value="&lt;b&gt;Why a fog layer?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;• Decisions keep working when the WAN is cut (RQ1).&lt;br&gt;• About 50 times less traffic upstream: only per-second&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;summaries leave the substation.&lt;br&gt;• Fast answers for control actions.&lt;br&gt;• Work and services can move between fog nodes&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(RQ2, RQ3).&lt;br&gt;• But fog nodes may be shared and less trusted, so&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;they get a trust score too.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=19;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40.0" y="3013.6000000000004" width="476.0" height="270" as="geometry" /></mxCell>
        <mxCell id="p1-note-160" value="&lt;b&gt;Safety first&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Protection trips (GOOSE messages between relays)&lt;br&gt;stay on the process bus and never wait for the PEP.&lt;br&gt;ZTC watches them but never blocks them. In&lt;br&gt;operational technology the order is safety, availability,&lt;br&gt;integrity, then confidentiality.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=19;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="546.0" y="3013.6000000000004" width="476.0" height="270" as="geometry" /></mxCell>
        <mxCell id="p1-note-161" value="&lt;b&gt;Fail closed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;If no decision can be made, the answer is no. An&lt;br&gt;attacker who cuts the WAN must not be able to switch&lt;br&gt;access control off. Availability comes from where&lt;br&gt;decisions are made, not from weaker failure modes.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=19;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1052.0" y="3013.6000000000004" width="476.0" height="270" as="geometry" /></mxCell>
        <mxCell id="p1-note-162" value="&lt;b&gt;One zone model, enforced four times&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;IEC 62443 zones and conduits are defined once and&lt;br&gt;exported to Kubernetes network policies, Docker&lt;br&gt;networks, Cisco ACLs and OpenStack security groups.&lt;br&gt;Segmentation and identity checks back each other up.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=19;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1558.0" y="3013.6000000000004" width="476.0" height="270" as="geometry" /></mxCell>
        <mxCell id="p1-note-163" value="&lt;b&gt;Secure supply chain&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Only Go's standard library in the trust path. Every&lt;br&gt;change passes race tests, linting, CodeQL,&lt;br&gt;govulncheck, gosec, gitleaks and Trivy, and ships as a&lt;br&gt;small non-root image with an SBOM.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=19;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2064.0" y="3013.6000000000004" width="476.0" height="270" as="geometry" /></mxCell>
        <mxCell id="p1-txt-164" value="&lt;b&gt;Research questions&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="40" y="3333.6000000000004" width="1400" height="35.68" as="geometry" /></mxCell>
        <mxCell id="p1-td-165" value="&lt;b&gt;RQ&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="3381.6000000000004" width="140" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-166" value="&lt;b&gt;Question&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="180" y="3381.6000000000004" width="1460" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-167" value="&lt;b&gt;Where in the diagram&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1640" y="3381.6000000000004" width="900" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-168" value="&lt;b&gt;RQ1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="3424.0400000000004" width="140" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-169" value="Where should decisions be made: only in the cloud, in the cloud with a cache on the fog, or with a full replica on the fog?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="180" y="3424.0400000000004" width="1460" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-170" value="Policy Decision Point and the decision cache (step 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1640" y="3424.0400000000004" width="900" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-171" value="&lt;b&gt;RQ2&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="3466.4800000000005" width="140" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-172" value="Which credential fits a system that moves: tokens, certificates or capabilities that can be narrowed?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="180" y="3466.4800000000005" width="1460" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-173" value="The certificate in steps 1 and 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1640" y="3466.4800000000005" width="900" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-174" value="&lt;b&gt;RQ3&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="3508.9200000000005" width="140" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-175" value="How does trust follow a service that moves to another fog node?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="180" y="3508.9200000000005" width="1460" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-176" value="Fog node and other fog nodes (TB5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1640" y="3508.9200000000005" width="900" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-177" value="&lt;b&gt;RQ4&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="3551.3600000000006" width="140" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-178" value="Is a compromised device locked out fast enough?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="180" y="3551.3600000000006" width="1460" height="42.44" as="geometry" /></mxCell>
        <mxCell id="p1-td-179" value="The loop from step 5 to step 6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1640" y="3551.3600000000006" width="900" height="42.44" as="geometry" /></mxCell>
