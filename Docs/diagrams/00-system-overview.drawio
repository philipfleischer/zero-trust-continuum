        <mxCell id="p1-txt-65" value="&lt;b&gt;Field network: process bus (GOOSE) and station bus (MMS, Modbus/TCP)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#6b4a00;" vertex="1" parent="1"><mxGeometry x="1000" y="1913" width="1200" height="26.44" as="geometry" /></mxCell>
