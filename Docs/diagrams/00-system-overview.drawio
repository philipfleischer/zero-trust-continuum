        <mxCell id="p0-systemov-1" value="ZTC — Zero-Trust Continuum: target architecture" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="10" width="1300" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p0-systemov-2" value="NIST SP 800-207 zero trust applied to the edge–fog–cloud continuum of a digital substation (IEC 61850 / IEC 62443). No component is trusted because of its network location: every request carries a verifiable identity, is decided by policy + continuously updated trust, and is enforced at a PEP." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="44" width="1300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p0-cloud" value="CLOUD — control centre  (Purdue L4, zone control-centre, SL-T 3)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#1f3a5f;" vertex="1" parent="p0-1">
