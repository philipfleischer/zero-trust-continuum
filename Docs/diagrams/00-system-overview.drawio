        <mxCell id="p1-hdr-63" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot;&gt;EDGE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Field devices&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#555555&quot;&gt;Purdue L0-2 · IEC 62443 SL-T 3&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;Measure, protect and switch the&lt;br&gt;physical grid.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#6b4a00;spacing=0;" vertex="1" parent="p1-edge-62"><mxGeometry x="24" y="22" width="270" height="260" as="geometry" /></mxCell>
