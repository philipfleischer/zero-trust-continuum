  <diagram name="At a glance" id="p0">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1930" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p0-txt-1" value="&lt;b&gt;ZTC: Zero-Trust Continuum at a glance&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=32;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1700" height="46.24" as="geometry" /></mxCell>
        <mxCell id="p0-txt-2" value="Four layers of a digital power substation and one rule they share: nothing is trusted because of where it sits on the network. The numbers follow one request through the system." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=20;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1700" height="30.400000000000002" as="geometry" /></mxCell>
        <mxCell id="p0-cloud-3" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;container=1;collapsible=0;recursiveResize=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="1720" height="290" as="geometry" /></mxCell>
        <mxCell id="p0-hdr-4" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot;&gt;CLOUD&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Control centre&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#555555&quot;&gt;Purdue L4-5&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;Decides: who is who, what is&lt;br&gt;allowed and how far to trust it.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#1f3a5f;spacing=0;" vertex="1" parent="p0-cloud-3"><mxGeometry x="24" y="22" width="270" height="260" as="geometry" /></mxCell>
        <mxCell id="p0-box-5" value="&lt;b&gt;Identity provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Gives every device and service&lt;br&gt;its own short-lived identity.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="250" width="280" height="170" as="geometry" /></mxCell>
        <mxCell id="p0-box-6" value="&lt;b&gt;Policy Decision Point&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Decides on every request from the policy and a live trust score per&lt;br&gt;device. Replicated, and every decision is logged.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="250" width="540" height="170" as="geometry" /></mxCell>
        <mxCell id="p0-box-7" value="&lt;b&gt;Telemetry and monitoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Stores the measurements, watches the&lt;br&gt;health of every service and raises alerts.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1380" y="250" width="350" height="170" as="geometry" /></mxCell>
        <mxCell id="p0-ln-8" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b85450;strokeWidth=2.5;dashed=1;dashPattern=12 7;endArrow=none;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="495" as="sourcePoint" /><mxPoint x="1760" y="495" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p0-txt-9" value="&lt;b&gt;TB3 across the WAN&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1582" y="465" width="174.28032" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p0-dmz-10" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;container=1;collapsible=0;recursiveResize=0;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="1720" height="230" as="geometry" /></mxCell>
        <mxCell id="p0-hdr-11" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot;&gt;OT-DMZ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Buffer zone&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#555555&quot;&gt;Purdue L3.5&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;Every crossing between&lt;br&gt;substation and control centre is&lt;br&gt;controlled here.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#4b2a5c;spacing=0;" vertex="1" parent="p0-dmz-10"><mxGeometry x="24" y="22" width="270" height="260" as="geometry" /></mxCell>
        <mxCell id="p0-box-12" value="&lt;b&gt;Firewall&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Encrypted tunnel for identities, decisions and revocations.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="640" width="720" height="100" as="geometry" /></mxCell>
        <mxCell id="p0-box-13" value="&lt;b&gt;Broker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Carries telemetry and trust signals.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1200" y="640" width="530" height="100" as="geometry" /></mxCell>
        <mxCell id="p0-fog-14" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;container=1;collapsible=0;recursiveResize=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1720" height="460" as="geometry" /></mxCell>
        <mxCell id="p0-hdr-15" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot;&gt;FOG&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Substation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#555555&quot;&gt;Purdue L3&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;Enforces: checks every request&lt;br&gt;locally and keeps working offline.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#2d4d1f;spacing=0;" vertex="1" parent="p0-fog-14"><mxGeometry x="24" y="22" width="270" height="260" as="geometry" /></mxCell>
        <mxCell id="p0-box-16" value="&lt;b&gt;Intrusion detection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Watches the traffic and&lt;br&gt;reports suspicious devices.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1130" y="900" width="240" height="130" as="geometry" /></mxCell>
        <mxCell id="p0-box-17" value="&lt;b&gt;Fog node&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Processes data and runs&lt;br&gt;tasks close to the devices.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1480" y="900" width="250" height="130" as="geometry" /></mxCell>
        <mxCell id="p0-box-18" value="&lt;b&gt;Policy Enforcement Point&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;The gatekeeper: lets only allowed&lt;br&gt;requests through. Keeps recent answers&lt;br&gt;to work offline.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="1070" width="340" height="130" as="geometry" /></mxCell>
