        <mxCell id="p0-systemov-60" value="&lt;b&gt;Runs as&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;laptop demo · Docker Compose (one network per zone) · Kubernetes on kind / k3s · NREC VMs and Raspberry Pi fog nodes (Terraform + Ansible)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=12;fontColor=#222222;spacing=4;" vertex="1" parent="p0-1">
