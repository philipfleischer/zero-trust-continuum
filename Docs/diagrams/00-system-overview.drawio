        <mxCell id="p0-txt-25" value="copy" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=15;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1405.5264" y="934" width="38.9472" height="23.8" as="geometry" /></mxCell>
        <mxCell id="p0-ln-26" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b85450;strokeWidth=2.5;dashed=1;dashPattern=12 7;endArrow=none;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1295" as="sourcePoint" /><mxPoint x="1760" y="1295" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p0-txt-27" value="&lt;b&gt;TB1 device ↔ gatekeeper&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1420" y="1265" width="206.24576000000002" height="25.12" as="geometry" /></mxCell>
        <mxCell id="p0-edge-28" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;container=1;collapsible=0;recursiveResize=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="1720" height="290" as="geometry" /></mxCell>
        <mxCell id="p0-hdr-29" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot;&gt;EDGE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Field devices&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#555555&quot;&gt;Purdue L0-2&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;The physical grid. Every device&lt;br&gt;has its own identity.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#6b4a00;spacing=0;" vertex="1" parent="p0-edge-28"><mxGeometry x="24" y="22" width="270" height="260" as="geometry" /></mxCell>
        <mxCell id="p0-box-30" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fffaf2;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="1380" width="1330" height="44" as="geometry" /></mxCell>
        <mxCell id="p0-txt-31" value="&lt;b&gt;Field network&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#6b4a00;" vertex="1" parent="1"><mxGeometry x="800" y="1391" width="900" height="26.44" as="geometry" /></mxCell>
        <mxCell id="p0-box-32" value="&lt;b&gt;Measure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;PMUs and smart meters&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="1480" width="295" height="110" as="geometry" /></mxCell>
        <mxCell id="p0-ln-33" style="edgeStyle=none;html=1;rounded=0;strokeColor=#999999;strokeWidth=1.5;endArrow=none;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="547.5" y="1480" as="sourcePoint" /><mxPoint x="547.5" y="1424" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p0-box-34" value="&lt;b&gt;Protect and control&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Protection relays, breakers and&lt;br&gt;RTUs&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="745" y="1480" width="295" height="110" as="geometry" /></mxCell>
        <mxCell id="p0-ln-35" style="edgeStyle=none;html=1;rounded=0;strokeColor=#999999;strokeWidth=1.5;endArrow=none;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="892.5" y="1480" as="sourcePoint" /><mxPoint x="892.5" y="1424" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p0-box-36" value="&lt;b&gt;Charge and maintain&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;EV chargers and engineer laptops&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1090" y="1480" width="295" height="110" as="geometry" /></mxCell>
        <mxCell id="p0-ln-37" style="edgeStyle=none;html=1;rounded=0;strokeColor=#999999;strokeWidth=1.5;endArrow=none;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1237.5" y="1480" as="sourcePoint" /><mxPoint x="1237.5" y="1424" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p0-box-38" value="&lt;b&gt;Threat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;A compromised or rogue device on&lt;br&gt;the same network&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=8;align=center;" vertex="1" parent="1"><mxGeometry x="1435" y="1480" width="295" height="110" as="geometry" /></mxCell>
