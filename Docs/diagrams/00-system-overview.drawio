        <mxCell id="p0-dmz" value="OT-DMZ + WAN  (Purdue L3.5, SL-T 2)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=20;fontColor=#4b2a5c;" vertex="1" parent="p0-1">
