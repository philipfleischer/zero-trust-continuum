        <mxCell id="p0-fw" value="&lt;b&gt;SUB1-FW&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;zone-based firewall, IKEv2/IPsec site-to-site to the control centre&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=18;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-dmz">
