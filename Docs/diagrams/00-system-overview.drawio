        </mxCell>
        <mxCell id="p0-broker" value="&lt;b&gt;Broker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;MQTT over TLS, update server&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=18;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-dmz">
          <mxGeometry x="670" y="45" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p0-systemov-13" value="WAN&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;MPLS / fibre / 4G–5G&lt;br&gt;slow, can partition&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;ellipse;shape=cloud;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontSize=17;" vertex="1" parent="p0-dmz">
          <mxGeometry x="1150" y="25" width="240" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p0-systemov-14" value="&lt;span style=&quot;font-size:17px&quot;&gt;No conduit skips a Purdue level unless it ends in the DMZ. Every conduit into an SL-T 3 zone is encrypted.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=top;fontSize=18;fontColor=#222222;fontColor=#4b2a5c;" vertex="1" parent="p0-dmz">
          <mxGeometry x="1420" y="40" width="300" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p0-systemov-15" value="③ cache miss: POST /v1/decide (mTLS, 8181)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.304;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-fw" target="p0-pdpgrp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-fog" value="FOG — substation  (Purdue L3, zone substation-fog, SL-T 3)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=20;fontColor=#2d4d1f;" vertex="1" parent="p0-1">
          <mxGeometry x="20" y="760" width="1740" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p0-pep" value="&lt;b&gt;ztc-pep&lt;br&gt;Policy Enforcement Point&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;mTLS termination, credential check (SVID / token / capability), per-request authorization, obligations (log, rate-limit, re-verify), reverse proxy&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=18;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-fog">
          <mxGeometry x="20" y="50" width="330" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p0-cache" value="&lt;b&gt;Decision cache / fog PDP replica&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;TTL, policy version, revocation epoch&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=17;" vertex="1" parent="p0-fog">
          <mxGeometry x="20" y="270" width="180" height="112" as="geometry" />
        </mxCell>
        <mxCell id="p0-fognode" value="&lt;b&gt;ztc-fog — fog node&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:17px&quot;&gt;&lt;li&gt;telemetry pipeline: validate, range, enrich&lt;/li&gt;&lt;li&gt;tumbling windows: 50 Hz raw → 1 Hz aggregates&lt;/li&gt;&lt;li&gt;trust-aware computation offloading&lt;/li&gt;&lt;li&gt;SWIM membership (gossip)&lt;/li&gt;&lt;li&gt;Chord placement of device state&lt;/li&gt;&lt;li&gt;secure migration endpoint (sealed state, handover ticket)&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=18;fontColor=#222222;verticalAlign=middle;spacing=4;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p0-fog">
          <mxGeometry x="450" y="50" width="400" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p0-ids" value="&lt;b&gt;ztc-ids — ICS intrusion detection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Modbus/TCP + GOOSE rules (MITRE ATT&amp;amp;CK for ICS), EWMA / CUSUM anomaly scores&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=18;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-fog">
          <mxGeometry x="900" y="50" width="370" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p0-peer" value="&lt;b&gt;ztc-fog peers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;offload targets, migration targets, Chord ring members&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=18;fontColor=#222222;verticalAlign=middle;spacing=4;" vertex="1" parent="p0-fog">
          <mxGeometry x="900" y="240" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p0-systemov-16" value="&lt;b&gt;Why a fog layer?&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px;font-size:17px&quot;&gt;&lt;li&gt;decisions keep working when the WAN partitions (RQ1)&lt;/li&gt;&lt;li&gt;50× less upstream traffic through aggregation&lt;/li&gt;&lt;li&gt;low latency for control actions&lt;/li&gt;&lt;li&gt;tasks offload and services migrate between fog nodes (RQ2, RQ3)&lt;/li&gt;&lt;li&gt;but: fog nodes may be multi-party and less trusted, so they get a trust score too&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=17;fontColor=#333333;" vertex="1" parent="p0-fog">
          <mxGeometry x="1310" y="50" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p0-systemov-17" value="② decide?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;startArrow=block;startFill=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.37;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-pep" target="p0-cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-systemov-18" value="④ allowed&lt;br&gt;request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.18;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-pep" target="p0-fognode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-systemov-19" value="raw&lt;br&gt;events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#333333;fontColor=#222222;exitX=1;exitY=0.18;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="p0-1" source="p0-fognode" target="p0-ids">
