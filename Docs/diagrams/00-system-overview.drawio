        <mxCell id="p0-systemov-59" value="&lt;b&gt;One zone model, four enforcement layers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;IEC 62443 zones and conduits defined once in Go and exported to Kubernetes NetworkPolicies, Docker networks, Cisco ACLs / zone-based firewall and OpenStack security groups&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=18;fontColor=#222222;spacing=4;" vertex="1" parent="p0-1">
